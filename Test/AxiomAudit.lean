import ExtremeValueTheory

/-!
# Axiom audit

Fails `lake build Test` if any declaration of the library depends on an axiom other than `propext`,
`Classical.choice` and `Quot.sound`. A `sorry` anywhere in a proof shows up here as `sorryAx`, and a
`native_decide` as `Lean.ofReduceBool`, including when it is hidden in a macro or generated by a
tactic, which the textual check in `scripts/check_source.py` cannot see.

It covers every declaration in a module under `ExtremeValueTheory` reachable from the umbrella import,
not a list of headline theorems, so a new result needs no registration. `scripts/check_source.py`
fails if a library file is not reachable, which would hide it from this audit.
-/

open Lean Elab Command

/-- The axioms a proof in this library may use. -/
private def allowedAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

run_cmd do
  let env ← getEnv
  let inLibrary (n : Name) : Bool :=
    match env.getModuleIdxFor? n with
    | some i => (`ExtremeValueTheory).isPrefixOf env.header.moduleNames[i.toNat]!
    | none => false
  let decls := env.constants.fold (init := #[]) fun acc n _ ↦
    if inLibrary n then acc.push n else acc
  -- Guards against the filter selecting nothing, which would make the audit pass vacuously.
  unless decls.size > 5000 && inLibrary
      ``CumulativeDistributionFunction.IsExtremeValueDistr.classification do
    throwError "axiom audit: expected the library's declarations, found {decls.size}"
  let mut used : NameSet := {}
  let mut culprits : Array (Name × Array Name) := #[]
  for n in decls do
    let axioms ← collectAxioms n
    used := axioms.foldl NameSet.insert used
    let bad := axioms.filter (!allowedAxioms.contains ·)
    unless bad.isEmpty do culprits := culprits.push (n, bad)
  unless culprits.isEmpty do
    throwError "axiom audit: {culprits.size} declarations use forbidden axioms, including \
      {culprits.toList.take 20}"
  logInfo m!"axiom audit: {decls.size} declarations use only {used.toList}"
