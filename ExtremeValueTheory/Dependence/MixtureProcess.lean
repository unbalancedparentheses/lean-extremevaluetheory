import ExtremeValueTheory.Dependence.EchoProcess

/-!
# A mixture with no late-return mass and no extremal index

Let `(Z_t)_{t ∈ ℤ}` be iid Pareto(`α`) and let `E` be an event, independent of the whole sequence
`Z`, with `p = P(E) ∈ (0, 1)`. The **mixture process** is
`X_t = Z_0` on `E` (a constant sequence) and `X_t = Z_t` off `E` (an iid sequence).

* Its spectral tail process is the mixture of the two spectral tail processes: `Θ ≡ 1` with
  probability `p`, `Θ_t = 1{t = 0}` with probability `1 - p`; so `ϑ = 1 - p`.
* For blocks with `rₙ → ∞`, `rₙ uₙ^(-α) → 0` the cluster ratio tends to `1 - p = ϑ`: the late-return
  mass of `Dependence/ThetaGap.lean` is `η = 0`. Yet forward anticlustering fails (on `E` the
  exceedance at `0` recurs at every lag).
* `P(M_n ≤ uₙ) → p + (1 - p) e^(-τ)` when `n P(X_0 > uₙ) → τ`: the limit is not of the form
  `e^(-θ τ)`, so there is no extremal index, and the block condition `𝒜(uₙ)` fails.

So `η = 0` is strictly weaker than anticlustering, and `η = 0` does not imply that `θ` exists:
the identity `θ = ϑ - η` of `Dependence/ThetaGap.lean` needs `𝒜(uₙ)`, which is exactly what the
mixture (a non-ergodic process) violates.

## Main definitions

* `mixtureProcess E Z`: the model.
* `innovationSigma Z`: the σ-algebra `σ(Z_t, t ∈ ℤ)`; independence of `E` is stated as
  `Indep (generateFrom {E}) (innovationSigma Z) P`.
* `mixtureCoin p`: the law `p δ_true + (1 - p) δ_false` on `Bool`;
  `mixtureSpectral t b = 1` if `b` or `t = 0`, else `0`.

## Main results, with the hypotheses each one uses

Common hypotheses: `E` measurable (`hE`), independent of `σ(Z)` (`hEZ`); `Z` measurable (`hZ`),
iid (`hind`, `hlaw : P.map (Z t) = paretoMeasure 1 α`), and where stated `α > 0` (`hα`) and
`Z ≥ 0` pointwise (`hpos`).

* `measureReal_partialMax_mixture_le` (`hE hEZ hZ hind hlaw`): for `n ≥ 1`,
  `P(M_n ≤ u) = p (1 - F̄(u)) + (1 - p) (1 - F̄(u))^n` with `F̄(u) = P(Z_0 > u)`.
* `tendsto_partialMax_mixture` (same): `n P(X_0 > uₙ) → τ` gives
  `P(M_n ≤ uₙ) → p + (1 - p) e^(-τ)`.
* `not_hasExtremalIndex_mixture` (`+ hα`, `0 < p < 1`): no `θ` is an extremal index.
* `tendsto_clusterRatio_mixture` (`hE hEZ hα hZ hind hlaw hpos`, `uₙ → ∞`, `rₙ → ∞`,
  `rₙ uₙ^(-α) → 0`): the cluster ratio tends to `1 - p`.
* `not_forwardAntiClusteringAt_mixture` (`hEZ hα hZ hlaw hpos`, `p > 0`, `uₙ → ∞`, `rₙ → ∞`).
* `hasShiftInvariantWindows_mixture` (`hE hEZ hZ hind hlaw`): stationarity.
* `hasSpectralTailProcess_mixture` (`hE hEZ hα hZ hind hlaw hpos`) and
  `candidateExtremalIndex_mixture` (`α > 0`): `Θ` as above, `ϑ = 1 - p`.
* `hasLateReturnMass_mixture` (`hE hEZ hα hZ hind hlaw hpos`, `uₙ → ∞`, `rₙ → ∞`,
  `rₙ uₙ^(-α) → 0`): `η = 0`.
* `not_conditionA_mixture` (`hE hEZ hα hZ hind hlaw hpos`, `0 < p < 1`, `n P(X_0 > uₙ) → τ > 0`,
  `rₙ → ∞`, `rₙ / n → 0`): `𝒜(uₙ)` fails for `|X|`. Proof: under `𝒜(uₙ)`, `η = 0` would force
  `P(M_n ≤ uₙ) → e^(-(1 - p) τ) < p + (1 - p) e^(-τ)` (strict convexity of `exp`).

## Remarks

* The limit `p + (1 - p) e^(-τ)` is the classical behaviour of a non-ergodic stationary sequence:
  conditionally on the regime, each regime has an extremal index (`0` for the constant sequence,
  `1` for the iid one), but the mixture has none.
* The innovations are assumed nonnegative pointwise (`hpos`), as in `Dependence/EchoProcess.lean`.
-/

open MeasureTheory ProbabilityTheory Filter Topology Set BoundedContinuousFunction
open scoped ENNReal NNReal

namespace ExtremeValueTheory

section Mixture

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
  {α : ℝ} {Z : ℤ → Ω → ℝ} {E : Set Ω}

open Classical in
/-- **The mixture process**: on the event `E`, the constant sequence `X_t = Z_0`; off `E`, the
iid sequence `X_t = Z_t`. -/
noncomputable def mixtureProcess (E : Set Ω) (Z : ℤ → Ω → ℝ) (t : ℤ) (ω : Ω) : ℝ :=
  if ω ∈ E then Z 0 ω else Z t ω

/-- The σ-algebra generated by the innovations `(Z_t)_{t ∈ ℤ}`. -/
abbrev innovationSigma (Z : ℤ → Ω → ℝ) : MeasurableSpace Ω :=
  ⨆ t, MeasurableSpace.comap (Z t) inferInstance

theorem comap_le_innovationSigma (t : ℤ) :
    MeasurableSpace.comap (Z t) inferInstance ≤ innovationSigma Z :=
  le_iSup (fun t => MeasurableSpace.comap (Z t) inferInstance) t

theorem measurable_innovationSigma (t : ℤ) : Measurable[innovationSigma Z] (Z t) :=
  Measurable.of_comap_le (comap_le_innovationSigma t)

theorem mixtureProcess_of_mem {ω : Ω} (h : ω ∈ E) (t : ℤ) : mixtureProcess E Z t ω = Z 0 ω := by
  simp [mixtureProcess, h]

theorem mixtureProcess_of_notMem {ω : Ω} (h : ω ∉ E) (t : ℤ) :
    mixtureProcess E Z t ω = Z t ω := by
  simp [mixtureProcess, h]

theorem mixtureProcess_zero_apply (ω : Ω) : mixtureProcess E Z 0 ω = Z 0 ω := by
  by_cases h : ω ∈ E
  · exact mixtureProcess_of_mem h 0
  · exact mixtureProcess_of_notMem h 0

theorem mixtureProcess_zero : mixtureProcess E Z 0 = Z 0 := by
  funext ω
  by_cases h : ω ∈ E
  · exact mixtureProcess_of_mem h 0
  · exact mixtureProcess_of_notMem h 0

theorem measurable_mixtureProcess (hE : MeasurableSet E) (hZ : ∀ t, Measurable (Z t)) (t : ℤ) :
    Measurable (mixtureProcess E Z t) :=
  Measurable.ite hE (hZ 0) (hZ t)

theorem mixtureProcess_nonneg (hpos : ∀ t ω, 0 ≤ Z t ω) (t : ℤ) (ω : Ω) :
    0 ≤ mixtureProcess E Z t ω := by
  by_cases h : ω ∈ E
  · rw [mixtureProcess_of_mem h]; exact hpos 0 ω
  · rw [mixtureProcess_of_notMem h]; exact hpos t ω

/-! ### Independence of the mixing event -/

section Indep

variable (hE : MeasurableSet E)
  (hEZ : Indep (MeasurableSpace.generateFrom {E}) (innovationSigma Z) P)

include hEZ in
omit [IsProbabilityMeasure P] in
theorem measureReal_inter_of_indep {A : Set Ω} (hA : MeasurableSet[innovationSigma Z] A) :
    P.real (E ∩ A) = P.real E * P.real A := by
  have := (Indep_iff _ _ P).1 hEZ E A (MeasurableSpace.measurableSet_generateFrom rfl) hA
  rw [measureReal_def, this, ENNReal.toReal_mul]
  rfl

include hE hEZ in
theorem measureReal_compl_inter_of_indep {A : Set Ω} (hA : MeasurableSet[innovationSigma Z] A) :
    P.real (Eᶜ ∩ A) = (1 - P.real E) * P.real A := by
  have hEm : MeasurableSet[MeasurableSpace.generateFrom {E}] E :=
    MeasurableSpace.measurableSet_generateFrom rfl
  have := (Indep_iff _ _ P).1 hEZ Eᶜ A hEm.compl hA
  rw [measureReal_def, this, ENNReal.toReal_mul, ← measureReal_def, ← measureReal_def,
    probReal_compl_eq_one_sub hE]

end Indep

/-! ### Maxima: no extremal index -/

variable (hE : MeasurableSet E)
  (hEZ : Indep (MeasurableSpace.generateFrom {E}) (innovationSigma Z) P)
  (hα : 0 < α) (hZ : ∀ t, Measurable (Z t)) (hind : iIndepFun Z P)
  (hlaw : ∀ t, P.map (Z t) = paretoMeasure 1 α) (hpos : ∀ t ω, 0 ≤ Z t ω)

include hE hEZ hZ hind hlaw in
/-- **The law of the maximum**: with `p = P(E)` and `F̄(u) = P(Z_0 > u)`,
`P(max_{0 ≤ k < n} X_k ≤ u) = p (1 - F̄(u)) + (1 - p) (1 - F̄(u))^n` for `n ≥ 1`. -/
theorem measureReal_partialMax_mixture_le {n : ℕ} (hn : 0 < n) (u : ℝ) :
    P.real {ω | partialMax (fun k : ℕ => mixtureProcess E Z k) n ω ≤ u} =
      P.real E * (1 - P.real {ω | u < Z 0 ω}) +
        (1 - P.real E) * (1 - P.real {ω | u < Z 0 ω}) ^ n := by
  set M : Set Ω := maxLE (fun k : ℕ => Z k) (Finset.range n) u
  have hset : {ω | partialMax (fun k : ℕ => mixtureProcess E Z k) n ω ≤ u} =
      (E ∩ Z 0 ⁻¹' Iic u) ∪ (Eᶜ ∩ M) := by
    ext ω
    simp only [mem_ofPred_eq, partialMax_le_iff hn, mem_union, mem_inter_iff, mem_preimage,
      mem_Iic, mem_compl_iff, M, maxLE, Finset.mem_range]
    by_cases h : ω ∈ E
    · simp only [mixtureProcess_of_mem h, h, true_and, not_true_eq_false, false_and, or_false]
      exact ⟨fun H => H 0 hn, fun H _ _ => H⟩
    · simp only [mixtureProcess_of_notMem h, h, false_and, not_false_eq_true, true_and,
        false_or]
  have hM : MeasurableSet[innovationSigma Z] M :=
    measurableSet_maxLE_of_comap_le (fun t _ => comap_le_innovationSigma (Z := Z) t) u
  have hI : MeasurableSet[innovationSigma Z] (Z 0 ⁻¹' Iic u) :=
    measurable_innovationSigma 0 measurableSet_Iic
  have hMm : MeasurableSet M := measurableSet_maxLE (fun k => hZ k) _ u
  have hdisj : Disjoint (E ∩ Z 0 ⁻¹' Iic u) (Eᶜ ∩ M) :=
    Disjoint.mono inter_subset_left inter_subset_left disjoint_compl_right
  rw [hset, measureReal_union hdisj (hE.compl.inter hMm), measureReal_inter_of_indep hEZ hI,
    measureReal_compl_inter_of_indep hE hEZ hM]
  have hc : P.real (Z 0 ⁻¹' Iic u) = 1 - P.real {ω | u < Z 0 ω} := by
    have : Z 0 ⁻¹' Iic u = {ω | u < Z 0 ω}ᶜ := by ext ω; simp
    rw [this, probReal_compl_eq_one_sub (measurableSet_lt measurable_const (hZ 0))]
  have hidZ : ∀ k : ℕ, IdentDistrib (Z k) (Z ((0 : ℕ) : ℤ)) P P := fun k =>
    ⟨(hZ _).aemeasurable, (hZ _).aemeasurable, by rw [hlaw, hlaw]⟩
  have hindN : iIndepFun (fun k : ℕ => Z k) P :=
    hind.precomp (g := fun k : ℕ => (k : ℤ)) Nat.cast_injective
  rw [hc, measureReal_maxLE_of_iIndepFun hindN hidZ, Finset.card_range]
  congr 2
  have : {ω | Z ((0 : ℕ) : ℤ) ω ≤ u} = Z 0 ⁻¹' Iic u := rfl
  rw [this, hc]

include hE hEZ hZ hind hlaw in
/-- **The maximum has a non-exponential limit**: if `n P(X_0 > uₙ) → τ`, then
`P(max_{0 ≤ k < n} X_k ≤ uₙ) → p + (1 - p) e^(-τ)`, a mixture of the limit `1` of the constant
sequence (which, at this level, exceeds `uₙ` with vanishing probability) and the iid limit
`e^(-τ)`. -/
theorem tendsto_partialMax_mixture {u : ℕ → ℝ} {τ : ℝ}
    (hτ : Tendsto (fun n : ℕ => n * P.real {ω | u n < mixtureProcess E Z 0 ω}) atTop (𝓝 τ)) :
    Tendsto (fun n => P.real {ω | partialMax (fun k : ℕ => mixtureProcess E Z k) n ω ≤ u n})
      atTop (𝓝 (P.real E + (1 - P.real E) * Real.exp (-τ))) := by
  rw [mixtureProcess_zero] at hτ
  set b : ℕ → ℝ := fun n => P.real {ω | u n < Z 0 ω}
  have hb : Tendsto b atTop (𝓝 0) := tendsto_zero_of_tendsto_natCast_mul' hτ
  have hpow := tendsto_one_sub_pow_exp_of_tendsto_mul (k := fun n => n) hb hτ
  have hlim : Tendsto (fun n => P.real E * (1 - b n) + (1 - P.real E) * (1 - b n) ^ n) atTop
      (𝓝 (P.real E + (1 - P.real E) * Real.exp (-τ))) := by
    have := ((hb.const_sub 1).const_mul (P.real E)).add (hpow.const_mul (1 - P.real E))
    simpa using this
  refine hlim.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with n hn
  exact (measureReal_partialMax_mixture_le hE hEZ hZ hind hlaw hn (u n)).symm

include hE hEZ hα hZ hind hlaw in
/-- **The mixture has no extremal index** when `0 < P(E) < 1`: the limits
`p + (1 - p) e^(-τ)` of `tendsto_partialMax_mixture` are not of the form `e^(-θ τ)`
(at `τ = 1, 2` this would force `p (1 - p) (1 - e^(-1))^2 = 0`). -/
theorem not_hasExtremalIndex_mixture (hp0 : 0 < P.real E) (hp1 : P.real E < 1) (θ : ℝ) :
    ¬ HasExtremalIndex (fun k : ℕ => mixtureProcess E Z k) P θ := by
  rintro ⟨-, h⟩
  have key : ∀ τ : ℝ, 0 < τ → Real.exp (-(θ * τ)) = P.real E + (1 - P.real E) * Real.exp (-τ) := by
    intro τ hτ0
    set u : ℕ → ℝ := fun n => ((n : ℝ) / τ) ^ (1 / α)
    have hu : Tendsto (fun n : ℕ => n * P.real {ω | u n < mixtureProcess E Z 0 ω}) atTop
        (𝓝 τ) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [eventually_ge_atTop ⌈τ⌉₊, eventually_gt_atTop 0] with n hn hn0
      have hn' : (0 : ℝ) < n := by exact_mod_cast hn0
      have hnτ : τ ≤ n := (Nat.le_ceil τ).trans (by exact_mod_cast hn)
      have h1 : 1 ≤ (n : ℝ) / τ := by rwa [le_div_iff₀ hτ0, one_mul]
      have hu1 : 1 ≤ u n := Real.one_le_rpow h1 (by positivity)
      rw [mixtureProcess_zero, measureReal_lt_of_map_eq hZ hlaw hα 0 hu1]
      simp only [u]
      rw [← Real.rpow_mul (by positivity), show 1 / α * -α = -1 by field_simp,
        Real.rpow_neg_one]
      field_simp
    have h1 := h τ hτ0 u (by simpa using hu)
    exact tendsto_nhds_unique h1 (tendsto_partialMax_mixture hE hEZ hZ hind hlaw hu)
  have k1 := key 1 one_pos
  have k2 := key 2 two_pos
  set a := Real.exp (-1)
  have ha2 : Real.exp (-2) = a ^ 2 := by
    rw [← Real.exp_nat_mul]; norm_num
  have hθ2 : Real.exp (-(θ * 2)) = Real.exp (-(θ * 1)) ^ 2 := by
    rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
  rw [hθ2, k1, ha2] at k2
  have ha1 : a < 1 := Real.exp_lt_one_iff.2 (by norm_num)
  set p := P.real E
  have : p * (1 - p) * (1 - a) ^ 2 = 0 := by linear_combination -k2
  have hpos : 0 < p * (1 - p) * (1 - a) ^ 2 := by
    have : 0 < 1 - a := by linarith
    have : 0 < 1 - p := by linarith
    positivity
  linarith

/-! ### The cluster ratio and anticlustering -/

include hE hEZ hα hZ hind hlaw hpos in
/-- **The cluster ratio of the mixture tends to `1 - p`** whenever `uₙ → ∞`, `rₙ → ∞` and
`rₙ uₙ^(-α) → 0`: on `E` the whole block exceeds as soon as `Z_0` does (one cluster, counted once,
of probability `p uₙ^(-α)`, negligible against `rₙ uₙ^(-α)`); off `E` the block behaves like an
iid block. -/
theorem tendsto_clusterRatio_mixture {u : ℕ → ℝ} (hu : Tendsto u atTop atTop) {r : ℕ → ℕ}
    (hr : Tendsto r atTop atTop)
    (hrb : Tendsto (fun n => (r n : ℝ) * u n ^ (-α)) atTop (𝓝 0)) :
    Tendsto (clusterRatio P (mixtureProcess E Z) u r) atTop (𝓝 (1 - P.real E)) := by
  set p := P.real E
  set b : ℕ → ℝ := fun n => u n ^ (-α)
  have hrinv : Tendsto (fun n => p / (r n : ℝ)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop (tendsto_natCast_atTop_atTop.comp hr)
  have hlow : Tendsto (fun n => p / r n + (1 - p) * (1 - r n * b n)) atTop (𝓝 (1 - p)) := by
    have := hrinv.add ((hrb.const_sub 1).const_mul (1 - p))
    simpa using this
  have hup : Tendsto (fun n => p / r n + (1 - p)) atTop (𝓝 (1 - p)) := by
    simpa using hrinv.add_const (1 - p)
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hlow hup ?_ ?_
  all_goals
    filter_upwards [hu.eventually_ge_atTop 1, hr.eventually_gt_atTop 0] with n hn hrn
    have hb : 0 < b n := Real.rpow_pos_of_pos (by linarith) _
    have hR0 : (0 : ℝ) < r n := by exact_mod_cast hrn
    set B : Set Ω := {ω | ∃ k < r n, u n < Z k ω}
    have hBm : MeasurableSet[innovationSigma Z] B := by
      have : B = ⋃ k ∈ Finset.range (r n), Z k ⁻¹' Ioi (u n) := by
        ext ω; simp [B]
      rw [this]
      exact Finset.measurableSet_biUnion _ fun k _ =>
        measurable_innovationSigma (k : ℤ) measurableSet_Ioi
    have hBm' : MeasurableSet B := by
      have : B = ⋃ k ∈ Finset.range (r n), Z k ⁻¹' Ioi (u n) := by
        ext ω; simp [B]
      rw [this]
      exact Finset.measurableSet_biUnion _ fun k _ => hZ _ measurableSet_Ioi
    have hI : MeasurableSet[innovationSigma Z] (Z 0 ⁻¹' Ioi (u n)) :=
      measurable_innovationSigma 0 measurableSet_Ioi
    have hset : {ω | ∃ t ∈ Finset.Ico (0 : ℤ) (r n), u n < |mixtureProcess E Z t ω|} =
        (E ∩ Z 0 ⁻¹' Ioi (u n)) ∪ (Eᶜ ∩ B) := by
      ext ω
      simp only [mem_ofPred_eq, mem_union, mem_inter_iff, mem_preimage, mem_Ioi, mem_compl_iff,
        B, Finset.mem_Ico]
      by_cases h : ω ∈ E
      · simp only [mixtureProcess_of_mem h, h, true_and, not_true_eq_false, false_and, or_false,
          abs_of_nonneg (hpos 0 ω)]
        exact ⟨fun ⟨_, _, H⟩ => H, fun H => ⟨0, ⟨le_rfl, by exact_mod_cast hrn⟩, H⟩⟩
      · simp only [mixtureProcess_of_notMem h, h, false_and, not_false_eq_true, true_and,
          false_or]
        constructor
        · rintro ⟨t, ⟨h0, h1⟩, H⟩
          obtain ⟨k, rfl⟩ : ∃ k : ℕ, t = k := ⟨t.toNat, by omega⟩
          exact ⟨k, by exact_mod_cast h1, by rwa [abs_of_nonneg (hpos _ ω)] at H⟩
        · rintro ⟨k, hk, H⟩
          exact ⟨k, ⟨by positivity, by exact_mod_cast hk⟩,
            H.trans_le (le_abs_self _)⟩
    have hdisj : Disjoint (E ∩ Z 0 ⁻¹' Ioi (u n)) (Eᶜ ∩ B) :=
      Disjoint.mono inter_subset_left inter_subset_left disjoint_compl_right
    have hP0 : P.real {ω | u n < |mixtureProcess E Z 0 ω|} = b n := by
      rw [mixtureProcess_zero]
      simp only [abs_of_nonneg (hpos 0 _)]
      exact measureReal_lt_of_map_eq hZ hlaw hα 0 hn
    have hZ0 : P.real (Z 0 ⁻¹' Ioi (u n)) = b n := measureReal_lt_of_map_eq hZ hlaw hα 0 hn
    have hval : clusterRatio P (mixtureProcess E Z) u r n =
        (p * b n + (1 - p) * P.real B) / (r n * b n) := by
      rw [clusterRatio, hset, measureReal_union hdisj (hE.compl.inter hBm'),
        measureReal_inter_of_indep hEZ hI, measureReal_compl_inter_of_indep hE hEZ hBm, hZ0,
        hP0]
    have hp1 : 0 ≤ 1 - p := by
      have := measureReal_le_one (μ := P) (s := E); linarith
    rw [hval]
  · -- lower bound
    have hBlow := le_measureReal_exists_lt_innovation hα hZ hind hlaw (P := P) (r n) hn
    rw [le_div_iff₀ (by positivity)]
    have e : (p / r n + (1 - p) * (1 - r n * b n)) * (r n * b n) =
        p * b n + (1 - p) * (r n * b n - (r n * b n) ^ 2) := by
      field_simp
    rw [e]
    gcongr
  · -- upper bound
    have hBup : P.real B ≤ r n * b n := by
      have : B = ⋃ k ∈ Finset.range (r n), Z k ⁻¹' Ioi (u n) := by
        ext ω; simp [B]
      rw [this]
      refine (measureReal_biUnion_finset_le _ _).trans (le_of_eq ?_)
      rw [Finset.sum_congr rfl fun (k : ℕ) _ => show P.real (Z (k : ℤ) ⁻¹' Ioi (u n)) = b n from
        measureReal_lt_of_map_eq hZ hlaw hα (k : ℤ) hn]
      simp [b]
    rw [div_le_iff₀ (by positivity)]
    have e : (p / r n + (1 - p)) * (r n * b n) = p * b n + (1 - p) * (r n * b n) := by
      field_simp
    rw [e]
    gcongr

include hEZ hα hZ hlaw hpos in
/-- **The mixture violates forward anticlustering** along every `uₙ → ∞`, `rₙ → ∞`, when
`P(E) > 0`: on `E` the exceedance at `0` recurs at every lag. -/
theorem not_forwardAntiClusteringAt_mixture (hp0 : 0 < P.real E) {u : ℕ → ℝ}
    (hu : Tendsto u atTop atTop) {r : ℕ → ℕ} (hr : Tendsto r atTop atTop) :
    ¬ ForwardAntiClusteringAt P (mixtureProcess E Z) u r := by
  intro hAC
  obtain ⟨m, hm⟩ := hAC (P.real E / 2) (by positivity)
  obtain ⟨n, hn, hn1, hrn⟩ := (hm.and ((hu.eventually_ge_atTop 1).and
    (hr.eventually_ge_atTop m))).exists
  have hb : 0 < u n ^ (-α) := Real.rpow_pos_of_pos (by linarith) _
  have hI : MeasurableSet[innovationSigma Z] (Z 0 ⁻¹' Ioi (u n)) :=
    measurable_innovationSigma 0 measurableSet_Ioi
  have hZ0 : P.real (Z 0 ⁻¹' Ioi (u n)) = u n ^ (-α) := measureReal_lt_of_map_eq hZ hlaw hα 0 hn1
  have hP0 : P.real {ω | u n < |mixtureProcess E Z 0 ω|} = u n ^ (-α) := by
    rw [mixtureProcess_zero]
    simp only [abs_of_nonneg (hpos 0 _)]
    exact measureReal_lt_of_map_eq hZ hlaw hα 0 hn1
  have hsub : E ∩ Z 0 ⁻¹' Ioi (u n) ⊆ {ω | u n < |mixtureProcess E Z 0 ω| ∧
      ∃ t : ℤ, (m : ℤ) ≤ t ∧ t ≤ r n ∧ u n < |mixtureProcess E Z t ω|} := by
    rintro ω ⟨hω, h⟩
    have h' : u n < |Z 0 ω| := lt_of_lt_of_le h (le_abs_self _)
    refine ⟨by rwa [mixtureProcess_of_mem hω], m, le_rfl, by exact_mod_cast hrn, ?_⟩
    rwa [mixtureProcess_of_mem hω]
  have h1 := measureReal_mono (μ := P) hsub
  rw [measureReal_inter_of_indep hEZ hI, hZ0] at h1
  rw [hP0] at hn
  nlinarith

/-! ### Stationarity -/

include hE hEZ hZ in
/-- The law of a window of the mixture is the mixture of the window laws:
`P(X_{S + h} ∈ B) = P(E, (Z_0, …, Z_0) ∈ B) + (1 - p) P(Z_{S + h} ∈ B)`. -/
theorem measureReal_window_mixture (h : ℤ) (S : Finset ℤ)
    {B : Set (S → ℝ)} (hB : MeasurableSet B) :
    P.real ((fun ω (t : S) => mixtureProcess E Z (t + h) ω) ⁻¹' B) =
      P.real (E ∩ (fun ω (_ : S) => Z 0 ω) ⁻¹' B) +
        (1 - P.real E) * P.real ((fun ω (t : S) => Z (t + h) ω) ⁻¹' B) := by
  have hW : Measurable[innovationSigma Z] (fun ω (t : S) => Z (t + h) ω) :=
    by let := innovationSigma Z; exact Measurable.of_eval fun t => measurable_innovationSigma _
  have hWm : Measurable (fun ω (t : S) => Z (t + h) ω) := measurable_pi_iff.2 fun t => hZ _
  have hset : (fun ω (t : S) => mixtureProcess E Z (t + h) ω) ⁻¹' B =
      (E ∩ (fun ω (_ : S) => Z 0 ω) ⁻¹' B) ∪ (Eᶜ ∩ (fun ω (t : S) => Z (t + h) ω) ⁻¹' B) := by
    ext ω
    by_cases hω : ω ∈ E
    · simp [mixtureProcess_of_mem hω, hω]
    · simp [mixtureProcess_of_notMem hω, hω]
  rw [hset, measureReal_union (Disjoint.mono inter_subset_left inter_subset_left
    disjoint_compl_right) (hE.compl.inter (hWm hB)),
    measureReal_compl_inter_of_indep hE hEZ (hW hB)]

include hE hEZ hZ hind hlaw in
/-- **The mixture is stationary**: a mixture, with weights independent of the noise, of the
constant sequence and the iid sequence, both stationary. -/
theorem hasShiftInvariantWindows_mixture : HasShiftInvariantWindows P (mixtureProcess E Z) := by
  have hid : ∀ i, IdentDistrib (Z i) (Z 0) P P := fun i =>
    ⟨(hZ _).aemeasurable, (hZ _).aemeasurable, by rw [hlaw, hlaw]⟩
  have hZs : HasShiftInvariantWindows P Z := by
    have := hasShiftInvariantWindows_of_shift hZ hind hid (G := fun z => z 0)
      (measurable_pi_apply 0)
    simpa using this
  intro h S
  have hX : ∀ k, Measurable fun ω (t : S) => mixtureProcess E Z (t + k) ω := fun k =>
    measurable_pi_iff.2 fun t => measurable_mixtureProcess hE hZ _
  have hWm : ∀ k, Measurable (fun ω (t : S) => Z (t + k) ω) := fun k =>
    measurable_pi_iff.2 fun t => hZ _
  have e0 : (fun ω (t : S) => mixtureProcess E Z t ω) =
      fun ω (t : S) => mixtureProcess E Z (t + 0) ω := by simp
  ext B hB
  rw [Measure.map_apply (hX h) hB, e0, Measure.map_apply (hX 0) hB,
    ← ofReal_measureReal (measure_ne_top _ _), ← ofReal_measureReal (measure_ne_top _ _),
    measureReal_window_mixture hE hEZ hZ h S hB, measureReal_window_mixture hE hEZ hZ 0 S hB]
  have key : ∀ k, P.real ((fun ω (t : S) => Z (t + k) ω) ⁻¹' B) =
      P.real ((fun ω (t : S) => Z t ω) ⁻¹' B) := by
    intro k
    have := congrArg (fun μ : Measure (S → ℝ) => μ.real B) (hZs k S)
    rwa [map_measureReal_apply (hWm k) hB,
      map_measureReal_apply (measurable_pi_iff.2 fun t => hZ _) hB] at this
  rw [key h, key 0]

/-! ### The spectral tail process -/

/-- The mixing law on `Bool`: `true` (the constant regime) with probability `p`, `false` (the
iid regime) with probability `1 - p`. -/
noncomputable def mixtureCoin (p : ℝ) : Measure Bool :=
  ENNReal.ofReal p • Measure.dirac true + ENNReal.ofReal (1 - p) • Measure.dirac false

theorem isProbabilityMeasure_mixtureCoin {p : ℝ} (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    IsProbabilityMeasure (mixtureCoin p) := by
  constructor
  simp only [mixtureCoin, Measure.coe_add, Measure.coe_smul, Pi.add_apply, Pi.smul_apply,
    measure_univ, smul_eq_mul, mul_one]
  rw [← ENNReal.ofReal_add hp0 (by linarith)]
  simp

/-- The spectral tail process of the mixture: `Θ_t = 1` for all `t` on `true` (the constant
regime), `Θ_t = 1{t = 0}` on `false` (the iid regime). -/
def mixtureSpectral (t : ℤ) (b : Bool) : ℝ := if b = true ∨ t = 0 then 1 else 0

theorem measurable_mixtureSpectral (t : ℤ) : Measurable (mixtureSpectral t) :=
  measurable_from_top

/-- **The candidate extremal index of the mixture is `ϑ = 1 - p`**: the constant regime
contributes `0` (it exceeds again at every positive lag), the iid regime `1`. -/
theorem candidateExtremalIndex_mixture (hα : 0 < α) (p : ℝ) :
    candidateExtremalIndex (mixtureCoin p) mixtureSpectral α = ENNReal.ofReal (1 - p) := by
  have hT0 : (⨆ k : ℕ, ENNReal.ofReal |mixtureSpectral k true|) = 1 := by
    simp [mixtureSpectral]
  have hT1 : (⨆ k : ℕ, ENNReal.ofReal |mixtureSpectral (k + 1) true|) = 1 := by
    simp [mixtureSpectral]
  have hF0 : (⨆ k : ℕ, ENNReal.ofReal |mixtureSpectral k false|) = 1 := by
    refine le_antisymm (iSup_le fun k => ?_) (le_iSup_of_le 0 (by simp [mixtureSpectral]))
    unfold mixtureSpectral; split_ifs <;> simp
  have hF1 : (⨆ k : ℕ, ENNReal.ofReal |mixtureSpectral (k + 1) false|) = 0 := by
    refine ENNReal.iSup_eq_zero.2 fun k => ?_
    have h : ¬ (false = true ∨ ((k : ℤ) + 1 = 0)) := by
      rintro (h | h)
      · exact Bool.false_ne_true h
      · omega
    unfold mixtureSpectral
    split_ifs with h'
    · exact absurd (by simpa using h') h
    · simp
  rw [candidateExtremalIndex, mixtureCoin, lintegral_add_measure, lintegral_smul_measure,
    lintegral_smul_measure, lintegral_dirac, lintegral_dirac, hT0, hT1, hF0, hF1,
    ENNReal.zero_rpow_of_pos hα]
  simp

include hE hEZ hα hZ hind hlaw hpos in
/-- **The spectral tail process of the mixture** is the mixture of the spectral tail processes:
`Θ ≡ 1` with probability `p = P(E)` and `Θ = (…, 0, 1, 0, …)` with probability `1 - p`. Given
`X_0 > x`, the constant regime still has conditional probability `p` (the marginal of `X_0` is
`Z_0` in both regimes). -/
theorem hasSpectralTailProcess_mixture :
    HasSpectralTailProcess P (mixtureProcess E Z) α (mixtureCoin (P.real E)) mixtureSpectral := by
  set p := P.real E
  -- the iid sequence
  have hRV : IsRegularlyVarying (fun x => P.real {ω | x < |Z 0 ω|}) (-α) := by
    refine (IsRegularlyVarying.rpow_id (-α)).congr ?_
    filter_upwards [eventually_ge_atTop 1] with x hx
    simp only [abs_of_nonneg (hpos 0 _)]
    exact (measureReal_lt_of_map_eq hZ hlaw hα 0 hx).symm
  have hiid : HasSpectralTailProcess P Z α (Measure.dirac ()) unitSpectral := by
    refine hasSpectralTailProcess_of_asymptoticIndependence hZ (hpos 0) hRV fun t ht ε hε => ?_
    have hlim : Tendsto (fun x : ℝ => (ε * x) ^ (-α)) atTop (𝓝 0) :=
      (tendsto_rpow_neg_atTop hα).comp (tendsto_id.const_mul_atTop hε)
    refine hlim.congr' ?_
    filter_upwards [eventually_ge_atTop 1, eventually_ge_atTop (1 / ε)] with x hx hxε
    have hεx : 1 ≤ ε * x := by rwa [div_le_iff₀' hε] at hxε
    have e1 : {ω | x < |Z 0 ω| ∧ ε * x < |Z t ω|} =
        {ω | x < Z 0 ω} ∩ {ω | ε * x < Z t ω} := by
      ext ω; simp [abs_of_nonneg (hpos _ ω)]
    have e2 : {ω | x < |Z 0 ω|} = {ω | x < Z 0 ω} := by
      ext ω; simp [abs_of_nonneg (hpos _ ω)]
    rw [e1, e2, measureReal_lt_inter_lt_of_ne hZ hind hlaw hα (Ne.symm ht) hx hεx,
      measureReal_lt_of_map_eq hZ hlaw hα 0 hx]
    have : 0 < x ^ (-α) := Real.rpow_pos_of_pos (by linarith) _
    field_simp
  refine ⟨?_, fun S f => ?_⟩
  · simpa only [mixtureProcess_zero_apply] using hRV
  set one : S → ℝ := fun _ => 1
  set v : Ω → (S → ℝ) := fun ω t => Z t ω / |Z 0 ω|
  have hv : Measurable[innovationSigma Z] v := by
    let := innovationSigma Z
    exact Measurable.of_eval fun t => (measurable_innovationSigma _).div
      (continuous_abs.measurable.comp (measurable_innovationSigma 0))
  have hvm : Measurable v := measurable_pi_iff.2 fun t =>
    (hZ _).div (continuous_abs.measurable.comp (hZ 0))
  set w : Ω → (S → ℝ) := fun ω t => mixtureProcess E Z t ω / |mixtureProcess E Z 0 ω|
  have hwm : Measurable w := measurable_pi_iff.2 fun t =>
    (measurable_mixtureProcess hE hZ _).div
      (continuous_abs.measurable.comp (measurable_mixtureProcess hE hZ 0))
  have hs : ∀ x : ℝ, {ω | x < |mixtureProcess E Z 0 ω|} = Z 0 ⁻¹' Ioi x := fun x => by
    ext ω; simp [mixtureProcess_zero_apply, abs_of_nonneg (hpos 0 ω)]
  have hs' : ∀ x : ℝ, {ω | x < |Z 0 ω|} = Z 0 ⁻¹' Ioi x := fun x => by
    ext ω; simp [abs_of_nonneg (hpos 0 ω)]
  -- the decomposition of the conditional expectation
  have key : ∀ x : ℝ, 1 ≤ x → ∫ ω, f (w ω) ∂P[|{ω | x < |mixtureProcess E Z 0 ω|}] =
      p * f one + (1 - p) * ∫ ω, f (v ω) ∂P[|{ω | x < |Z 0 ω|}] := by
    intro x hx1
    have hx : 0 < x := by linarith
    rw [hs, hs']
    set A := Z 0 ⁻¹' Ioi x
    have hA0 : P A ≠ 0 := by
      intro h0
      have h1 : P.real A = x ^ (-α) := measureReal_lt_of_map_eq hZ hlaw hα 0 hx1
      rw [measureReal_def, h0, ENNReal.toReal_zero] at h1
      exact (Real.rpow_pos_of_pos hx _).ne' h1.symm
    have hAσ : MeasurableSet[innovationSigma Z] A :=
      measurable_innovationSigma 0 measurableSet_Ioi
    have hAm : MeasurableSet A := hZ 0 measurableSet_Ioi
    rw [ProbabilityTheory.cond, integral_smul_measure,
      integral_smul_measure, ← integral_inter_add_sdiff hE
        (show IntegrableOn (fun ω => f (w ω)) A P from
          ((f.integrable (P.map w)).comp_measurable hwm).integrableOn)]
    -- the constant regime
    have h1 : ∫ ω in A ∩ E, f (w ω) ∂P = (p * P.real A) * f one := by
      rw [setIntegral_congr_fun (hAm.inter hE) (g := fun _ => f one), setIntegral_const,
        inter_comm, measureReal_inter_of_indep hEZ hAσ, smul_eq_mul]
      intro ω ⟨hωA, hωE⟩
      have hz : 0 < Z 0 ω := lt_trans hx hωA
      simp only [w, one]
      congr 1
      funext t
      rw [mixtureProcess_of_mem hωE, mixtureProcess_of_mem hωE, abs_of_pos hz, div_self hz.ne']
    -- the iid regime
    have hmap : (P.restrict (A \ E)).map v = P Eᶜ • (P.restrict A).map v := by
      ext C hC
      rw [Measure.map_apply hvm hC, Measure.smul_apply, Measure.map_apply hvm hC,
        Measure.restrict_apply (hvm hC), Measure.restrict_apply (hvm hC), smul_eq_mul]
      have e : v ⁻¹' C ∩ (A \ E) = Eᶜ ∩ (v ⁻¹' C ∩ A) := by
        ext ω; simp only [mem_inter_iff, Set.mem_sdiff, mem_compl_iff]; tauto
      have hEm : MeasurableSet[MeasurableSpace.generateFrom {E}] E :=
        MeasurableSpace.measurableSet_generateFrom rfl
      rw [e, (Indep_iff _ _ P).1 hEZ _ _ hEm.compl ((hv hC).inter hAσ)]
    have h2 : ∫ ω in A \ E, f (w ω) ∂P = (1 - p) * ∫ ω in A, f (v ω) ∂P := by
      rw [setIntegral_congr_fun (hAm.diff hE) (g := fun ω => f (v ω))]
      · rw [← integral_map hvm.aemeasurable f.continuous.aestronglyMeasurable, hmap,
          integral_smul_measure, integral_map hvm.aemeasurable f.continuous.aestronglyMeasurable,
          ← measureReal_def, probReal_compl_eq_one_sub hE, smul_eq_mul]
      · intro ω ⟨_, hωE⟩
        simp only [w, v, mixtureProcess_of_notMem hωE]
    rw [h1, h2, smul_eq_mul, smul_eq_mul, ENNReal.toReal_inv, ← measureReal_def]
    have : P.real A ≠ 0 := by
      rw [measureReal_def]; exact ENNReal.toReal_ne_zero.2 ⟨hA0, measure_ne_top _ _⟩
    field_simp
  -- the limit
  have hlim := hiid.2 S f
  have htarget : ∫ y, f y ∂((mixtureCoin p).map fun ω' (t : S) => mixtureSpectral t ω') =
      p * f one + (1 - p) *
        ∫ y, f y ∂((Measure.dirac ()).map fun ω' (t : S) => unitSpectral t ω') := by
    have hm : Measurable fun ω' : Bool => fun t : S => mixtureSpectral t ω' := measurable_from_top
    have hmap : (mixtureCoin p).map (fun ω' (t : S) => mixtureSpectral t ω') =
        ENNReal.ofReal p • Measure.dirac (fun t : S => mixtureSpectral t true) +
          ENNReal.ofReal (1 - p) • Measure.dirac (fun t : S => mixtureSpectral t false) := by
      rw [mixtureCoin, Measure.map_add _ _ hm, Measure.map_smul, Measure.map_smul,
        Measure.map_dirac' hm, Measure.map_dirac' hm]
      all_goals exact hm.aemeasurable
    rw [hmap, Measure.map_dirac' (measurable_pi_iff.2 fun t => measurable_unitSpectral _),
      integral_add_measure ((integrable_dirac enorm_lt_top).smul_measure ENNReal.ofReal_ne_top)
        ((integrable_dirac enorm_lt_top).smul_measure ENNReal.ofReal_ne_top),
      integral_smul_measure, integral_smul_measure, integral_dirac, integral_dirac,
      integral_dirac]
    have hp0 : 0 ≤ p := measureReal_nonneg
    have hp1 : 0 ≤ 1 - p := by have := measureReal_le_one (μ := P) (s := E); linarith
    rw [ENNReal.toReal_ofReal hp0, ENNReal.toReal_ofReal hp1, smul_eq_mul, smul_eq_mul]
    have e1 : (fun t : S => mixtureSpectral t true) = one := by
      funext t; simp [mixtureSpectral, one]
    have e2 : (fun t : S => mixtureSpectral t false) = fun t : S => unitSpectral t () := by
      funext t; simp [mixtureSpectral, unitSpectral]
    rw [e1, e2]
  show Tendsto (fun x => ∫ ω, f (w ω) ∂P[|{ω | x < |mixtureProcess E Z 0 ω|}]) atTop _
  rw [htarget]
  refine ((hlim.const_mul (1 - p)).const_add (p * f one)).congr' ?_
  filter_upwards [eventually_ge_atTop 1] with x hx
  exact (key x hx).symm

include hE hEZ hα hZ hind hlaw hpos in
/-- **No late returns**: along `uₙ → ∞`, `rₙ → ∞`, `rₙ uₙ^(-α) → 0` the late-return mass of the
mixture is `η = 0`, since the cluster ratio tends to `1 - p = ϑ`
(`tendsto_clusterRatio_mixture`, `HasSpectralTailProcess.tendsto_clusterRatio_iff`). -/
theorem hasLateReturnMass_mixture {u : ℕ → ℝ} (hu : Tendsto u atTop atTop) {r : ℕ → ℕ}
    (hr : Tendsto r atTop atTop)
    (hrb : Tendsto (fun n => (r n : ℝ) * u n ^ (-α)) atTop (𝓝 0)) :
    HasLateReturnMass P (mixtureProcess E Z) u r 0 := by
  have := isProbabilityMeasure_mixtureCoin (p := P.real E) measureReal_nonneg measureReal_le_one
  have h := (hasSpectralTailProcess_mixture hE hEZ hα hZ hind hlaw hpos).tendsto_clusterRatio_iff
    hα (measurable_mixtureProcess hE hZ) measurable_mixtureSpectral
    (hasShiftInvariantWindows_mixture hE hEZ hZ hind hlaw) hu hr (1 - P.real E)
  rw [candidateExtremalIndex_mixture hα, ENNReal.toReal_ofReal
    (by have := measureReal_le_one (μ := P) (s := E); linarith), sub_self] at h
  exact h.1 (tendsto_clusterRatio_mixture hE hEZ hα hZ hind hlaw hpos hu hr hrb)

include hE hEZ hα hZ hind hlaw hpos in
/-- **The block condition `𝒜(uₙ)` fails** for the mixture with `0 < P(E) < 1`, along every level
sequence with `n P(X_0 > uₙ) → τ > 0` and every block length with `rₙ → ∞`, `rₙ / n → 0`.
Otherwise `θ = ϑ - η = 1 - p` (`HasSpectralTailProcess.tendsto_partialMax_iff_hasLateReturnMass`,
`hasLateReturnMass_mixture`) would give `P(M n ≤ uₙ) → e^(-(1 - p) τ)`, whereas the limit is
`p + (1 - p) e^(-τ)` (`tendsto_partialMax_mixture`), strictly larger by strict convexity of
`exp`. -/
theorem not_conditionA_mixture (hp0 : 0 < P.real E) (hp1 : P.real E < 1) {u : ℕ → ℝ} {τ : ℝ}
    (hτ0 : 0 < τ)
    (hτ : Tendsto (fun n : ℕ => n * P.real {ω | u n < mixtureProcess E Z 0 ω}) atTop (𝓝 τ))
    {r : ℕ → ℕ} (hr : Tendsto r atTop atTop)
    (hrn : Tendsto (fun n => (r n : ℝ) / n) atTop (𝓝 0)) :
    ¬ ConditionA (fun k : ℕ => |mixtureProcess E Z k|) P u r := by
  intro hA
  set p := P.real E
  have := isProbabilityMeasure_mixtureCoin (p := p) hp0.le hp1.le
  have hT := hasSpectralTailProcess_mixture hE hEZ hα hZ hind hlaw hpos
  have hτ' : Tendsto (fun n : ℕ => n * P.real {ω | u n < |mixtureProcess E Z 0 ω|}) atTop
      (𝓝 τ) := by
    simpa [abs_of_nonneg (mixtureProcess_nonneg hpos _ _)] using hτ
  have hu := hT.tendsto_atTop_of_tendsto_mul hτ'
  have hrb : Tendsto (fun n => (r n : ℝ) * u n ^ (-α)) atTop (𝓝 0) := by
    refine (tendsto_mul_of_tendsto_natCast_mul hτ hrn).congr' ?_
    filter_upwards [hu.eventually_ge_atTop 1] with n hn
    rw [mixtureProcess_zero, measureReal_lt_of_map_eq hZ hlaw hα 0 hn]
  have hη := hasLateReturnMass_mixture hE hEZ hα hZ hind hlaw hpos hu hr hrb
  have hiff := hT.tendsto_partialMax_iff_hasLateReturnMass hα (measurable_mixtureProcess hE hZ)
    measurable_mixtureSpectral (hasShiftInvariantWindows_mixture hE hEZ hZ hind hlaw) hτ' hτ0 hr
    hrn hA (1 - p)
  rw [candidateExtremalIndex_mixture hα, ENNReal.toReal_ofReal (by linarith), sub_self] at hiff
  have h1 := hiff.2 hη
  have h2 := tendsto_partialMax_mixture hE hEZ hZ hind hlaw hτ
  have h2' : Tendsto (fun n => P.real {ω | partialMax (fun k : ℕ => |mixtureProcess E Z k|) n ω ≤
      u n}) atTop (𝓝 (p + (1 - p) * Real.exp (-τ))) := by
    refine h2.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with n hn
    congr 1
    ext ω
    simp only [mem_ofPred_eq, partialMax_le_iff hn, Pi.abs_apply,
      abs_of_nonneg (mixtureProcess_nonneg hpos _ _)]
  have heq := tendsto_nhds_unique h1 h2'
  have hconv := strictConvexOn_exp.2 (Set.mem_univ (0 : ℝ)) (Set.mem_univ (-τ))
    (by linarith : (0 : ℝ) ≠ -τ) hp0 (by linarith : 0 < 1 - p) (by ring)
  simp only [smul_eq_mul, mul_zero, zero_add, Real.exp_zero, mul_one] at hconv
  rw [show -((1 - p) * τ) = (1 - p) * -τ by ring] at heq
  linarith

end Mixture

