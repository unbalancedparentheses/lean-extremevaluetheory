import ExtremeValueTheory.Dependence.EchoProcess

/-!
# A mixture with no escaping mass and no extremal index

DOCSTRING
-/

open MeasureTheory ProbabilityTheory Filter Topology Set BoundedContinuousFunction
open scoped ENNReal NNReal

namespace ExtremeValueTheory

section Mixture

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]
  {α : ℝ} {Z : ℤ → Ω → ℝ} {E : Set Ω}

open Classical in
/-- **The mixture process**: on the event `E`, the constant sequence `X_t = Z_0`; off `E`, the
iid sequence `X_t = Z_t`. -/
noncomputable def mixtureProcess (E : Set Ω) (Z : ℤ → Ω → ℝ) (t : ℤ) (ω : Ω) : ℝ :=
  if ω ∈ E then Z 0 ω else Z t ω

/-- The σ-algebra generated by the innovations `(Z_t)_{t ∈ ℤ}`. -/
def innovationSigma (Z : ℤ → Ω → ℝ) : MeasurableSpace Ω :=
  ⨆ t, MeasurableSpace.comap (Z t) inferInstance

theorem comap_le_innovationSigma (t : ℤ) :
    MeasurableSpace.comap (Z t) inferInstance ≤ innovationSigma Z :=
  le_iSup (fun t => MeasurableSpace.comap (Z t) inferInstance) t

theorem measurable_innovationSigma (t : ℤ) : Measurable[innovationSigma Z] (Z t) :=
  Measurable.of_comap_le (comap_le_innovationSigma t)

theorem mixtureProcess_of_mem {ω : Ω} (h : ω ∈ E) (t : ℤ) : mixtureProcess E Z t ω = Z 0 ω :=
  if_pos h

theorem mixtureProcess_of_notMem {ω : Ω} (h : ω ∉ E) (t : ℤ) : mixtureProcess E Z t ω = Z t ω :=
  if_neg h

theorem mixtureProcess_zero : mixtureProcess E Z 0 = Z 0 := by
  funext ω
  by_cases h : ω ∈ E
  · exact mixtureProcess_of_mem h 0
  · exact mixtureProcess_of_notMem h 0

theorem measurable_mixtureProcess (hE : MeasurableSet E) (hZ : ∀ t, Measurable (Z t)) (t : ℤ) :
    Measurable (mixtureProcess E Z t) :=
  Measurable.ite hE (hZ 0) (hZ t)

theorem mixtureProcess_nonneg (hpos : ∀ t ω, 0 ≤ Z t ω) (t : ℤ) (ω : Ω) :
    0 ≤ mixtureProcess E Z t ω := by
  by_cases h : ω ∈ E
  · rw [mixtureProcess_of_mem h]; exact hpos 0 ω
  · rw [mixtureProcess_of_notMem h]; exact hpos t ω

/-! ### Independence of the mixing event -/

section Indep

variable (hE : MeasurableSet E)
  (hEZ : Indep (MeasurableSpace.generateFrom {E}) (innovationSigma Z) P)

include hEZ in
omit [IsProbabilityMeasure P] in
theorem measureReal_inter_of_indep {A : Set Ω} (hA : MeasurableSet[innovationSigma Z] A) :
    P.real (E ∩ A) = P.real E * P.real A := by
  have := (Indep_iff _ _ P).1 hEZ E A (MeasurableSpace.measurableSet_generateFrom rfl) hA
  rw [measureReal_def, this, ENNReal.toReal_mul]
  rfl

include hE hEZ in
theorem measureReal_compl_inter_of_indep {A : Set Ω} (hA : MeasurableSet[innovationSigma Z] A) :
    P.real (Eᶜ ∩ A) = (1 - P.real E) * P.real A := by
  have hEm : MeasurableSet[MeasurableSpace.generateFrom {E}] E :=
    MeasurableSpace.measurableSet_generateFrom rfl
  have := (Indep_iff _ _ P).1 hEZ Eᶜ A hEm.compl hA
  rw [measureReal_def, this, ENNReal.toReal_mul, ← measureReal_def, ← measureReal_def,
    probReal_compl_eq_one_sub hE]

end Indep

/-! ### Maxima: no extremal index -/

variable (hE : MeasurableSet E)
  (hEZ : Indep (MeasurableSpace.generateFrom {E}) (innovationSigma Z) P)
  (hα : 0 < α) (hZ : ∀ t, Measurable (Z t)) (hind : iIndepFun Z P)
  (hlaw : ∀ t, P.map (Z t) = paretoMeasure 1 α) (hpos : ∀ t ω, 0 ≤ Z t ω)

include hE hEZ hZ hind hlaw in
/-- **The law of the maximum**: with `p = P(E)` and `F̄(u) = P(Z_0 > u)`,
`P(max_{0 ≤ k < n} X_k ≤ u) = p (1 - F̄(u)) + (1 - p) (1 - F̄(u))^n` for `n ≥ 1`. -/
theorem measureReal_partialMax_mixture_le {n : ℕ} (hn : 0 < n) (u : ℝ) :
    P.real {ω | partialMax (fun k : ℕ => mixtureProcess E Z k) n ω ≤ u} =
      P.real E * (1 - P.real {ω | u < Z 0 ω}) +
        (1 - P.real E) * (1 - P.real {ω | u < Z 0 ω}) ^ n := by
  set M : Set Ω := maxLE (fun k : ℕ => Z k) (Finset.range n) u
  have hset : {ω | partialMax (fun k : ℕ => mixtureProcess E Z k) n ω ≤ u} =
      (E ∩ Z 0 ⁻¹' Iic u) ∪ (Eᶜ ∩ M) := by
    ext ω
    simp only [mem_ofPred_eq, partialMax_le_iff hn, mem_union, mem_inter_iff, mem_preimage,
      mem_Iic, mem_compl_iff, M, maxLE, Finset.mem_range]
    by_cases h : ω ∈ E
    · simp only [mixtureProcess_of_mem h, h, true_and, not_true_eq_false, false_and, or_false]
      exact ⟨fun H => H 0 hn, fun H _ _ => H⟩
    · simp only [mixtureProcess_of_notMem h, h, false_and, not_false_eq_true, true_and,
        false_or]
  have hM : MeasurableSet[innovationSigma Z] M :=
    measurableSet_maxLE_of_comap_le (fun t _ => comap_le_innovationSigma (Z := Z) t) u
  have hI : MeasurableSet[innovationSigma Z] (Z 0 ⁻¹' Iic u) :=
    measurable_innovationSigma 0 measurableSet_Iic
  have hMm : MeasurableSet M := measurableSet_maxLE (fun k => hZ k) _ u
  have hdisj : Disjoint (E ∩ Z 0 ⁻¹' Iic u) (Eᶜ ∩ M) :=
    Disjoint.mono inter_subset_left inter_subset_left disjoint_compl_right
  rw [hset, measureReal_union hdisj (hE.compl.inter hMm), measureReal_inter_of_indep hEZ hI,
    measureReal_compl_inter_of_indep hE hEZ hM]
  have hc : P.real (Z 0 ⁻¹' Iic u) = 1 - P.real {ω | u < Z 0 ω} := by
    have : Z 0 ⁻¹' Iic u = {ω | u < Z 0 ω}ᶜ := by ext ω; simp
    rw [this, probReal_compl_eq_one_sub (measurableSet_lt measurable_const (hZ 0))]
  have hidZ : ∀ k : ℕ, IdentDistrib (Z k) (Z ((0 : ℕ) : ℤ)) P P := fun k =>
    ⟨(hZ _).aemeasurable, (hZ _).aemeasurable, by rw [hlaw, hlaw]⟩
  have hindN : iIndepFun (fun k : ℕ => Z k) P :=
    hind.precomp (g := fun k : ℕ => (k : ℤ)) Nat.cast_injective
  rw [hc, measureReal_maxLE_of_iIndepFun hindN hidZ, Finset.card_range]
  congr 2
  have : {ω | Z ((0 : ℕ) : ℤ) ω ≤ u} = Z 0 ⁻¹' Iic u := rfl
  rw [this, hc]

include hE hEZ hZ hind hlaw in
/-- **The maximum has a non-exponential limit**: if `n P(X_0 > uₙ) → τ`, then
`P(max_{0 ≤ k < n} X_k ≤ uₙ) → p + (1 - p) e^(-τ)`, a mixture of the limit `1` of the constant
sequence (which, at this level, exceeds `uₙ` with vanishing probability) and the iid limit
`e^(-τ)`. -/
theorem tendsto_partialMax_mixture {u : ℕ → ℝ} {τ : ℝ}
    (hτ : Tendsto (fun n : ℕ => n * P.real {ω | u n < mixtureProcess E Z 0 ω}) atTop (𝓝 τ)) :
    Tendsto (fun n => P.real {ω | partialMax (fun k : ℕ => mixtureProcess E Z k) n ω ≤ u n})
      atTop (𝓝 (P.real E + (1 - P.real E) * Real.exp (-τ))) := by
  rw [mixtureProcess_zero] at hτ
  set b : ℕ → ℝ := fun n => P.real {ω | u n < Z 0 ω}
  have hb : Tendsto b atTop (𝓝 0) := tendsto_zero_of_tendsto_natCast_mul' hτ
  have hpow := tendsto_one_sub_pow_exp_of_tendsto_mul (k := fun n => n) hb hτ
  have hlim : Tendsto (fun n => P.real E * (1 - b n) + (1 - P.real E) * (1 - b n) ^ n) atTop
      (𝓝 (P.real E + (1 - P.real E) * Real.exp (-τ))) := by
    have := ((hb.const_sub 1).const_mul (P.real E)).add (hpow.const_mul (1 - P.real E))
    simpa using this
  refine hlim.congr' ?_
  filter_upwards [eventually_gt_atTop 0] with n hn
  exact (measureReal_partialMax_mixture_le hE hEZ hZ hind hlaw hn (u n)).symm

include hE hEZ hα hZ hind hlaw in
/-- **The mixture has no extremal index** when `0 < P(E) < 1`: the limits
`p + (1 - p) e^(-τ)` of `tendsto_partialMax_mixture` are not of the form `e^(-θ τ)`
(at `τ = 1, 2` this would force `p (1 - p) (1 - e^(-1))^2 = 0`). -/
theorem not_hasExtremalIndex_mixture (hp0 : 0 < P.real E) (hp1 : P.real E < 1) (θ : ℝ) :
    ¬ HasExtremalIndex (fun k : ℕ => mixtureProcess E Z k) P θ := by
  rintro ⟨-, h⟩
  have key : ∀ τ : ℝ, 0 < τ → Real.exp (-(θ * τ)) = P.real E + (1 - P.real E) * Real.exp (-τ) := by
    intro τ hτ0
    set u : ℕ → ℝ := fun n => ((n : ℝ) / τ) ^ (1 / α)
    have hu : Tendsto (fun n : ℕ => n * P.real {ω | u n < mixtureProcess E Z 0 ω}) atTop
        (𝓝 τ) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [eventually_ge_atTop ⌈τ⌉₊, eventually_gt_atTop 0] with n hn hn0
      have hn' : (0 : ℝ) < n := by exact_mod_cast hn0
      have hnτ : τ ≤ n := (Nat.le_ceil τ).trans (by exact_mod_cast hn)
      have h1 : 1 ≤ (n : ℝ) / τ := by rwa [le_div_iff₀ hτ0, one_mul]
      have hu1 : 1 ≤ u n := Real.one_le_rpow h1 (by positivity)
      rw [mixtureProcess_zero, measureReal_lt_of_map_eq hZ hlaw hα 0 hu1]
      simp only [u]
      rw [← Real.rpow_mul (by positivity), show 1 / α * -α = -1 by field_simp,
        Real.rpow_neg_one]
      field_simp
    have h1 := h τ hτ0 u (by simpa using hu)
    exact tendsto_nhds_unique h1 (tendsto_partialMax_mixture hE hEZ hZ hind hlaw hu)
  have k1 := key 1 one_pos
  have k2 := key 2 two_pos
  set a := Real.exp (-1)
  have ha2 : Real.exp (-2) = a ^ 2 := by
    rw [← Real.exp_nat_mul]; norm_num
  have hθ2 : Real.exp (-(θ * 2)) = Real.exp (-(θ * 1)) ^ 2 := by
    rw [← Real.exp_nat_mul]; congr 1; push_cast; ring
  rw [hθ2, k1, ha2] at k2
  have ha1 : a < 1 := Real.exp_lt_one_iff.2 (by norm_num)
  set p := P.real E
  have : p * (1 - p) * (1 - a) ^ 2 = 0 := by linear_combination -k2
  have hpos : 0 < p * (1 - p) * (1 - a) ^ 2 := by
    have : 0 < 1 - a := by linarith
    have : 0 < 1 - p := by linarith
    positivity
  linarith

/-! ### The cluster ratio and anticlustering -/

include hE hEZ hα hZ hind hlaw hpos in
/-- **The cluster ratio of the mixture tends to `1 - p`** whenever `uₙ → ∞`, `rₙ → ∞` and
`rₙ uₙ^(-α) → 0`: on `E` the whole block exceeds as soon as `Z_0` does (one cluster, counted once,
of probability `p uₙ^(-α)`, negligible against `rₙ uₙ^(-α)`); off `E` the block behaves like an
iid block. -/
theorem tendsto_clusterRatio_mixture {u : ℕ → ℝ} (hu : Tendsto u atTop atTop) {r : ℕ → ℕ}
    (hr : Tendsto r atTop atTop)
    (hrb : Tendsto (fun n => (r n : ℝ) * u n ^ (-α)) atTop (𝓝 0)) :
    Tendsto (clusterRatio P (mixtureProcess E Z) u r) atTop (𝓝 (1 - P.real E)) := by
  set p := P.real E
  set b : ℕ → ℝ := fun n => u n ^ (-α)
  have hrinv : Tendsto (fun n => p / (r n : ℝ)) atTop (𝓝 0) :=
    tendsto_const_nhds.div_atTop (tendsto_natCast_atTop_atTop.comp hr)
  have hlow : Tendsto (fun n => p / r n + (1 - p) * (1 - r n * b n)) atTop (𝓝 (1 - p)) := by
    have := hrinv.add ((hrb.const_sub 1).const_mul (1 - p))
    simpa using this
  have hup : Tendsto (fun n => p / r n + (1 - p)) atTop (𝓝 (1 - p)) := by
    simpa using hrinv.add_const (1 - p)
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le' hlow hup ?_ ?_
  all_goals
    filter_upwards [hu.eventually_ge_atTop 1, hr.eventually_gt_atTop 0] with n hn hrn
    have hb : 0 < b n := Real.rpow_pos_of_pos (by linarith) _
    have hR0 : (0 : ℝ) < r n := by exact_mod_cast hrn
    set B : Set Ω := {ω | ∃ k < r n, u n < Z k ω}
    have hBm : MeasurableSet[innovationSigma Z] B := by
      have : B = ⋃ k ∈ Finset.range (r n), Z k ⁻¹' Ioi (u n) := by
        ext ω; simp [B]
      rw [this]
      exact Finset.measurableSet_biUnion _ fun k _ =>
        measurable_innovationSigma (k : ℤ) measurableSet_Ioi
    have hBm' : MeasurableSet B := by
      have : B = ⋃ k ∈ Finset.range (r n), Z k ⁻¹' Ioi (u n) := by
        ext ω; simp [B]
      rw [this]
      exact Finset.measurableSet_biUnion _ fun k _ => hZ _ measurableSet_Ioi
    have hI : MeasurableSet[innovationSigma Z] (Z 0 ⁻¹' Ioi (u n)) :=
      measurable_innovationSigma 0 measurableSet_Ioi
    have hset : {ω | ∃ t ∈ Finset.Ico (0 : ℤ) (r n), u n < |mixtureProcess E Z t ω|} =
        (E ∩ Z 0 ⁻¹' Ioi (u n)) ∪ (Eᶜ ∩ B) := by
      ext ω
      simp only [mem_ofPred_eq, mem_union, mem_inter_iff, mem_preimage, mem_Ioi, mem_compl_iff,
        B, Finset.mem_Ico]
      by_cases h : ω ∈ E
      · simp only [mixtureProcess_of_mem h, h, true_and, not_true_eq_false, false_and, or_false,
          abs_of_nonneg (hpos 0 ω)]
        exact ⟨fun ⟨_, _, H⟩ => H, fun H => ⟨0, ⟨le_rfl, by exact_mod_cast hrn⟩, H⟩⟩
      · simp only [mixtureProcess_of_notMem h, h, false_and, not_false_eq_true, true_and,
          false_or]
        constructor
        · rintro ⟨t, ⟨h0, h1⟩, H⟩
          obtain ⟨k, rfl⟩ : ∃ k : ℕ, t = k := ⟨t.toNat, by omega⟩
          exact ⟨k, by exact_mod_cast h1, by rwa [abs_of_nonneg (hpos _ ω)] at H⟩
        · rintro ⟨k, hk, H⟩
          exact ⟨k, ⟨by positivity, by exact_mod_cast hk⟩,
            H.trans_le (le_abs_self _)⟩
    have hdisj : Disjoint (E ∩ Z 0 ⁻¹' Ioi (u n)) (Eᶜ ∩ B) :=
      Disjoint.mono inter_subset_left inter_subset_left disjoint_compl_right
    have hP0 : P.real {ω | u n < |mixtureProcess E Z 0 ω|} = b n := by
      rw [mixtureProcess_zero]
      simp only [abs_of_nonneg (hpos 0 _)]
      exact measureReal_lt_of_map_eq hZ hlaw hα 0 hn
    have hZ0 : P.real (Z 0 ⁻¹' Ioi (u n)) = b n := measureReal_lt_of_map_eq hZ hlaw hα 0 hn
    have hval : clusterRatio P (mixtureProcess E Z) u r n =
        (p * b n + (1 - p) * P.real B) / (r n * b n) := by
      rw [clusterRatio, hset, measureReal_union hdisj (hE.compl.inter hBm'),
        measureReal_inter_of_indep hEZ hI, measureReal_compl_inter_of_indep hE hEZ hBm, hZ0,
        hP0]
    have hp1 : 0 ≤ 1 - p := by
      have := measureReal_le_one (μ := P) (s := E); linarith
    rw [hval]
  · -- lower bound
    have hBlow := le_measureReal_exists_lt_innovation hα hZ hind hlaw (P := P) (r n) hn
    rw [le_div_iff₀ (by positivity)]
    have e : (p / r n + (1 - p) * (1 - r n * b n)) * (r n * b n) =
        p * b n + (1 - p) * (r n * b n - (r n * b n) ^ 2) := by
      field_simp
    rw [e]
    gcongr
  · -- upper bound
    have hBup : P.real B ≤ r n * b n := by
      have : B = ⋃ k ∈ Finset.range (r n), Z k ⁻¹' Ioi (u n) := by
        ext ω; simp [B]
      rw [this]
      refine (measureReal_biUnion_finset_le _ _).trans (le_of_eq ?_)
      rw [Finset.sum_congr rfl fun (k : ℕ) _ => show P.real (Z (k : ℤ) ⁻¹' Ioi (u n)) = b n from
        measureReal_lt_of_map_eq hZ hlaw hα (k : ℤ) hn]
      simp [b]
    rw [div_le_iff₀ (by positivity)]
    have e : (p / r n + (1 - p)) * (r n * b n) = p * b n + (1 - p) * (r n * b n) := by
      field_simp
    rw [e]
    gcongr

include hEZ hα hZ hlaw hpos in
/-- **The mixture violates forward anticlustering** along every `uₙ → ∞`, `rₙ → ∞`, when
`P(E) > 0`: on `E` the exceedance at `0` recurs at every lag. -/
theorem not_forwardAntiClusteringAt_mixture (hp0 : 0 < P.real E) {u : ℕ → ℝ}
    (hu : Tendsto u atTop atTop) {r : ℕ → ℕ} (hr : Tendsto r atTop atTop) :
    ¬ ForwardAntiClusteringAt P (mixtureProcess E Z) u r := by
  intro hAC
  obtain ⟨m, hm⟩ := hAC (P.real E / 2) (by positivity)
  obtain ⟨n, hn, hn1, hrn⟩ := (hm.and ((hu.eventually_ge_atTop 1).and
    (hr.eventually_ge_atTop m))).exists
  have hb : 0 < u n ^ (-α) := Real.rpow_pos_of_pos (by linarith) _
  have hI : MeasurableSet[innovationSigma Z] (Z 0 ⁻¹' Ioi (u n)) :=
    measurable_innovationSigma 0 measurableSet_Ioi
  have hZ0 : P.real (Z 0 ⁻¹' Ioi (u n)) = u n ^ (-α) := measureReal_lt_of_map_eq hZ hlaw hα 0 hn1
  have hP0 : P.real {ω | u n < |mixtureProcess E Z 0 ω|} = u n ^ (-α) := by
    rw [mixtureProcess_zero]
    simp only [abs_of_nonneg (hpos 0 _)]
    exact measureReal_lt_of_map_eq hZ hlaw hα 0 hn1
  have hsub : E ∩ Z 0 ⁻¹' Ioi (u n) ⊆ {ω | u n < |mixtureProcess E Z 0 ω| ∧
      ∃ t : ℤ, (m : ℤ) ≤ t ∧ t ≤ r n ∧ u n < |mixtureProcess E Z t ω|} := by
    rintro ω ⟨hω, h⟩
    have h' : u n < |Z 0 ω| := lt_of_lt_of_le h (le_abs_self _)
    refine ⟨by rwa [mixtureProcess_of_mem hω], m, le_rfl, by exact_mod_cast hrn, ?_⟩
    rwa [mixtureProcess_of_mem hω]
  have h1 := measureReal_mono (μ := P) hsub
  rw [measureReal_inter_of_indep hEZ hI, hZ0] at h1
  rw [hP0] at hn
  nlinarith

end Mixture

end ExtremeValueTheory
