import ExtremeValueTheory.Dependence.MDependent
import ExtremeValueTheory.Dependence.MovingMaxTailProcess
import ExtremeValueTheory.Dependence.MovingAverageTailProcess

/-!
# Extremal indices of sliding window processes through the main theorem

Sliding window functionals `X_t = F(Z_{t + d_1}, …, Z_{t + d_K})` of iid `ℤ`-indexed noise are
stationary and `m`-dependent (`m` the spread of the offsets), so
`HasSpectralTailProcess.hasExtremalIndex_of_isMDependent` identifies their extremal index with the
candidate extremal index `ϑ` of their spectral tail process. We apply this to the moving maximum
and to finite moving averages.

## Main results

* `ExtremeValueTheory.hasShiftInvariantWindows_of_iIndepFun`: iid `ℤ`-indexed noise is stationary.
* `ExtremeValueTheory.HasShiftInvariantWindows.slidingWindow`: sliding window functionals of a
  stationary series are stationary.
* `ExtremeValueTheory.isMDependent_slidingWindow`: sliding window functionals of iid noise with
  offsets in `[a, a + m]` are `m`-dependent.
* `ExtremeValueTheory.hasExtremalIndex_movingMax_of_isMDependent`: the moving maximum
  `max(Z_t, Z_{t+1})` of iid Pareto(`α`) noise has extremal index `1/2`, derived through the main
  theorem (a second proof of `hasExtremalIndex_movingMax`, independent of the direct computation).
* `ExtremeValueTheory.MovingAverage.hasExtremalIndex`: the finite moving average
  `X_t = ∑_{i ≤ m} ψ_i Z_{t-i}` with `ψ ≥ 0` and iid nonnegative regularly varying noise has
  extremal index `θ = max_j ψ_j^α / ∑_j ψ_j^α` ([EKM, §8.1, Example 8.1.4 type], [DR85]).
-/

open MeasureTheory ProbabilityTheory Filter Topology Finset

namespace ExtremeValueTheory

variable {Ω : Type*} {mΩ : MeasurableSpace Ω} {P : Measure Ω} {Z : ℤ → Ω → ℝ}

/-! ### Sliding windows of iid noise -/

section SlidingWindow

/-- **iid `ℤ`-indexed noise is stationary.** -/
theorem hasShiftInvariantWindows_of_iIndepFun [IsProbabilityMeasure P] (hZ : ∀ i, Measurable (Z i))
    (hind : iIndepFun Z P) (hid : ∀ i, IdentDistrib (Z i) (Z 0) P P) :
    HasShiftInvariantWindows P Z :=
  hasShiftInvariantWindows_of_isStationary hZ fun k =>
    isStationary_of_iIndepFun (fun n => hZ _)
      (hind.precomp (g := fun n : ℕ => (n : ℤ) + k) fun a b h => by simpa using h)
      fun n => (hid _).trans (hid _).symm

/-- **Sliding window functionals of a stationary series are stationary**:
`X_t = F(Z_{t + d_1}, …, Z_{t + d_K})`. -/
theorem HasShiftInvariantWindows.slidingWindow (hZ : ∀ i, Measurable (Z i))
    (hstat : HasShiftInvariantWindows P Z) {K : ℕ} (d : Fin K → ℤ) {F : (Fin K → ℝ) → ℝ}
    (hF : Measurable F) :
    HasShiftInvariantWindows P (fun t ω => F (fun j => Z (t + d j) ω)) := by
  intro h S
  set τ : S × Fin K → ℤ := fun q => q.1 + d q.2
  set G : (S × Fin K → ℝ) → (S → ℝ) := fun y t => F (fun j => y (t, j))
  have hG : Measurable G := measurable_pi_iff.2 fun t =>
    hF.comp (measurable_pi_iff.2 fun j => measurable_pi_apply _)
  have e1 : (fun ω (t : S) => F (fun j => Z (t + h + d j) ω)) =
      G ∘ fun ω q => Z (τ q + h) ω := by
    funext ω t
    simp only [Function.comp_apply, G, τ]
    congr 2; funext j; congr 1; ring
  have e2 : (fun ω (t : S) => F (fun j => Z (t + d j) ω)) = G ∘ fun ω q => Z (τ q) ω := rfl
  rw [e1, e2, ← Measure.map_map hG (measurable_pi_iff.2 fun q => hZ _),
    ← Measure.map_map hG (measurable_pi_iff.2 fun q => hZ _), hstat.map_comp hZ τ h]

/-- A sliding window functional at time `t` is measurable for the σ-algebra generated by the
noise at the times `t + d_j`. -/
theorem comap_slidingWindow_le {K : ℕ} (d : Fin K → ℤ) {F : (Fin K → ℝ) → ℝ}
    (hF : Measurable F) (t : ℤ) {S : Set ℤ} (hS : ∀ j, t + d j ∈ S) :
    MeasurableSpace.comap (fun ω => F (fun j => Z (t + d j) ω)) inferInstance ≤
      ⨆ i ∈ S, MeasurableSpace.comap (Z i) inferInstance := by
  let : MeasurableSpace Ω := ⨆ i ∈ S, MeasurableSpace.comap (Z i) inferInstance
  have hg : Measurable (fun ω j => Z (t + d j) ω) := by
    refine measurable_pi_iff.2 fun j => ?_
    rw [measurable_iff_comap_le]
    exact le_iSup₂_of_le (f := fun i (_ : i ∈ S) => MeasurableSpace.comap (Z i) inferInstance)
      (t + d j) (hS j) le_rfl
  exact (hF.comp hg).comap_le

/-- **Sliding window functionals of iid noise are `m`-dependent**: if `Z` is iid and the offsets
`d_j` lie in `[a, a + m]`, then `(X_n)_{n ∈ ℕ}`, `X_n = F(Z_{n + d_1}, …, Z_{n + d_K})`, is
`m`-dependent. -/
theorem isMDependent_slidingWindow (hZ : ∀ i, Measurable (Z i)) (hind : iIndepFun Z P)
    {K : ℕ} (d : Fin K → ℤ) {F : (Fin K → ℝ) → ℝ} (hF : Measurable F) {a : ℤ} {m : ℕ}
    (hd : ∀ j, a ≤ d j ∧ d j ≤ a + m) :
    IsMDependent (fun (n : ℕ) ω => F (fun j => Z (n + d j) ω)) m P := by
  intro s
  have hI := indep_iSup_of_disjoint (fun i => (hZ i).comap_le) hind.iIndep
    (S := {i : ℤ | i ≤ s + a + m}) (T := {i : ℤ | s + m + 1 + a ≤ i})
    (Set.disjoint_left.2 fun i (h1 : i ≤ _) (h2 : _ ≤ i) => by omega)
  refine indep_of_indep_of_le hI (iSup₂_le fun t ht => ?_) (iSup₂_le fun t ht => ?_)
  · exact comap_slidingWindow_le d hF t fun j => by
      show (t : ℤ) + d j ≤ s + a + m
      have := hd j; have : t ≤ s := ht; omega
  · exact comap_slidingWindow_le d hF t fun j => by
      show (s : ℤ) + m + 1 + a ≤ t + d j
      have := hd j; have : s + m + 1 ≤ t := ht; omega

end SlidingWindow

/-! ### The moving maximum -/

section MovingMax

variable [IsProbabilityMeasure P] {α : ℝ}

theorem movingMax_eq_slidingWindow :
    movingMax Z = fun t ω => (fun y : Fin 2 → ℝ => max (y 0) (y 1))
      (fun j => Z (t + (![0, 1] : Fin 2 → ℤ) j) ω) := by
  funext t ω; simp [movingMax]

/-- **`θ = ϑ = 1/2` for the moving maximum, through the main theorem.** Let `(Z_t)_{t ∈ ℤ}` be
iid Pareto(`α`), nonnegative, and `X_t = max(Z_t, Z_{t+1})`. Then `(X_n)_{n ∈ ℕ}` has extremal
index `ϑ = 1/2`. Unlike `hasExtremalIndex_movingMax` (a direct computation), this goes through
`HasSpectralTailProcess.hasExtremalIndex_of_isMDependent`: stationarity of the `ℤ`-indexed moving
maximum, `1`-dependence, the spectral tail process `hasSpectralTailProcess_movingMax`, and
`candidateExtremalIndex_movingMax`. -/
theorem hasExtremalIndex_movingMax_of_isMDependent (hα : 0 < α) (hZ : ∀ t, Measurable (Z t))
    (hind : iIndepFun Z P) (hlaw : ∀ t, P.map (Z t) = paretoMeasure 1 α)
    (hpos : ∀ t ω, 0 ≤ Z t ω) :
    HasExtremalIndex (fun n : ℕ => movingMax Z n) P 2⁻¹ := by
  have hF : Measurable fun y : Fin 2 → ℝ => max (y 0) (y 1) :=
    (measurable_pi_apply 0).max (measurable_pi_apply 1)
  have hid : ∀ i, IdentDistrib (Z i) (Z 0) P P := fun i =>
    ⟨(hZ _).aemeasurable, (hZ _).aemeasurable, by rw [hlaw, hlaw]⟩
  have hX : ∀ t, Measurable (movingMax Z t) := fun t => (hZ t).max (hZ (t + 1))
  have hstat : HasShiftInvariantWindows P (movingMax Z) := by
    rw [movingMax_eq_slidingWindow]
    exact (hasShiftInvariantWindows_of_iIndepFun hZ hind hid).slidingWindow hZ _ hF
  have hm : IsMDependent (fun n : ℕ => movingMax Z n) 1 P := by
    have := isMDependent_slidingWindow hZ hind ![0, 1] hF (a := 0) (m := 1) fun j => by
      fin_cases j <;> simp
    rw [movingMax_eq_slidingWindow]
    exact this
  have key :=
    (hasSpectralTailProcess_movingMax hα hZ hind hlaw hpos).hasExtremalIndex_of_isMDependent hα hX measurable_movingMaxSpectral hstat hm
  rw [candidateExtremalIndex_movingMax hα] at key
  have habs : (fun k : ℕ => |movingMax Z k|) = fun k : ℕ => movingMax Z k := by
    funext k ω
    exact abs_of_nonneg ((hpos _ ω).trans (le_max_left _ _))
  simpa [habs] using key

end MovingMax

/-! ### Finite moving averages -/

namespace MovingAverage

variable [IsProbabilityMeasure P] {α : ℝ} {m : ℕ} {ψ : ℕ → ℝ}

theorem process_eq_slidingWindow :
    process m ψ Z = fun t ω => (fun y : Fin (m + 1) → ℝ => ∑ j : Fin (m + 1), ψ j * y j)
      (fun j => Z (t + (fun j : Fin (m + 1) => -(j : ℤ)) j) ω) := by
  funext t ω
  simp only [process]
  rw [← Fin.sum_univ_eq_sum_range (fun i => ψ i * Z (t - i) ω)]
  rfl

/-- **The extremal index of a finite moving average** ([EKM, §8.1], [DR85], [KS20, §15.3]):
for `X_t = ∑_{i=0}^m ψ_i Z_{t-i}` with `ψ_0, …, ψ_m ≥ 0` (not all zero) and iid nonnegative
noise with regularly varying tail of index `-α`, the sequence `(X_n)_{n ∈ ℕ}` has extremal index
`θ = max_j ψ_j^α / ∑_j ψ_j^α`. Derived through the main theorem: `m`-dependence and stationarity
of the sliding window, the spectral tail process `MovingAverage.hasSpectralTailProcess` and
`MovingAverage.candidateExtremalIndex_spectral`. -/
theorem hasExtremalIndex (hZ : ∀ i, Measurable (Z i)) (hind : iIndepFun Z P)
    (hident : ∀ i, IdentDistrib (Z i) (Z 0) P P) (hZ0 : ∀ i ω, 0 ≤ Z i ω) (hα : 0 < α)
    (hL : IsRegularlyVarying (fun x => P.real {ω | x < Z 0 ω}) (-α)) (hψ0 : ∀ j, 0 ≤ ψ j)
    (hψm : ∀ j, m < j → ψ j = 0) (hW : 0 < weightSum m ψ α) :
    HasExtremalIndex (fun n : ℕ => process m ψ Z n) P
      ((range (m + 1)).sup' nonempty_range_add_one ψ ^ α / ∑ j ∈ range (m + 1), ψ j ^ α) := by
  have hF : Measurable fun y : Fin (m + 1) → ℝ => ∑ j : Fin (m + 1), ψ j * y j :=
    Finset.measurable_sum _ fun j _ => (measurable_pi_apply j).const_mul _
  have hstat : HasShiftInvariantWindows P (process m ψ Z) := by
    rw [process_eq_slidingWindow]
    exact (hasShiftInvariantWindows_of_iIndepFun hZ hind hident).slidingWindow hZ _ hF
  have hm : IsMDependent (fun n : ℕ => process m ψ Z n) m P := by
    have := isMDependent_slidingWindow hZ hind (fun j : Fin (m + 1) => -(j : ℤ)) hF
      (a := -m) (m := m) fun j => by have := j.isLt; constructor <;> omega
    rw [process_eq_slidingWindow]
    exact this
  obtain ⟨hTP, hϑ⟩ := exists_hasSpectralTailProcess_candidateExtremalIndex_eq hZ hind hident hZ0
    hα hL hψ0 hψm hW
  have := indexLaw_isProbabilityMeasure hψ0 hW
  have key := hTP.hasExtremalIndex_of_isMDependent hα (measurable_process hZ)
    (fun t => measurable_from_top) hstat hm
  have habs : (fun k : ℕ => |process m ψ Z k|) = fun k : ℕ => process m ψ Z k := by
    funext k ω
    exact abs_of_nonneg (process_nonneg hψ0 hZ0 _ ω)
  rw [hϑ, habs, ENNReal.toReal_ofReal] at key
  · exact key
  · exact div_nonneg (Real.rpow_nonneg ((hψ0 0).trans
      (le_sup' ψ (mem_range.2 (Nat.succ_pos m)))) _)
      (sum_nonneg fun j _ => Real.rpow_nonneg (hψ0 j) _)

end MovingAverage

end ExtremeValueTheory
