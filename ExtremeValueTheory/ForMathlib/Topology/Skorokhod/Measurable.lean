/-!
# The Borel σ-algebra of the Skorokhod space

We equip the Skorokhod space `D([0, 1], E)` with its Borel σ-algebra for the `J₁` topology and
show that the coordinate projections `π_t : x ↦ x t` are measurable. When `E` is second countable
the projections generate the Borel σ-algebra
([Billingsley, *Convergence of Probability Measures*, Theorem 12.5][billingsley1999]).

The projections `π_0` and `π_1` are continuous, but for `0 < t < 1` the projection `π_t` is
discontinuous at every `x` that jumps at `t`. Billingsley's proof for real valued paths uses the
continuous functionals `x ↦ ε⁻¹ ∫_t^{t+ε} x`. We instead use, for a continuous `g : E → ℝ≥0∞`,
the functionals `x ↦ ⨅ s ∈ (t, b), g (x s)`. These are upper semicontinuous on `D`, hence Borel,
and by right continuity they converge to `g (x t)` as `b ↓ t`. Taking `g` to be the distance to
a closed set gives the measurability of `π_t`.

For the converse we approximate `x ∈ D` by the step functions `x ∘ ⌊(n + 1) · ⌋ / (n + 1)`,
which depend on finitely many coordinates of `x` and converge to `x` in the Skorokhod
topology: a time change moving the cut points of Billingsley's Lemma 12.1 onto the grid aligns
the cells of the step function with those of `x`.

## Main statements

* `SkorokhodSpace.upperSemicontinuous_iInf_Ioo`: `x ↦ ⨅ s ∈ (a, b), g (x s)` is upper
  semicontinuous on `D` for continuous `g`.
* `SkorokhodSpace.measurable_apply`: the projections `π_t` are Borel measurable.
* `SkorokhodSpace.measurable_coeFn`: the map `D → (I → E)` is measurable for the product
  σ-algebra, i.e. the σ-algebra generated by the projections is contained in the Borel σ-algebra.
* `SkorokhodSpace.measurableSpace_eq_comap_coeFn`, `SkorokhodSpace.measurableSpace_eq_iSup_comap`:
  for second countable `E`, the Borel σ-algebra is generated by the projections.

## References

* [P. Billingsley, *Convergence of Probability Measures*][billingsley1999]
-/

@[expose] public section

open Filter Set Topology Metric unitInterval
open scoped ENNReal

/-- If `h` is right-continuous at `t`, then `⨅ s ∈ (t, b), h s` tends to `h t` as `b ↓ t`. -/
lemma tendsto_iInf_Ioo_nhdsGT {X β : Type*} [LinearOrder X] [DenselyOrdered X]
    [TopologicalSpace X] [OrderTopology X] [CompleteLinearOrder β] [TopologicalSpace β]
    [OrderTopology β] [DenselyOrdered β] {h : X → β} {t u : X} (htu : t < u)
    (hh : ContinuousWithinAt h (Ioi t) t) :
    Tendsto (fun b ↦ ⨅ s ∈ Ioo t b, h s) (𝓝[>] t) (𝓝 (h t)) := by
  refine tendsto_order.2 ⟨fun a ha ↦ ?_, fun c hc ↦ ?_⟩
  · obtain ⟨a', haa', ha't⟩ := exists_between ha
    obtain ⟨b₀, hb₀, hb₀s⟩ := (mem_nhdsGT_iff_exists_Ioo_subset' htu).1
      (hh.eventually (lt_mem_nhds ha't))
    filter_upwards [Ioo_mem_nhdsGT hb₀] with b hb
    exact haa'.trans_le (le_iInf₂ fun s hs ↦ (hb₀s ⟨hs.1, hs.2.trans hb.2⟩).le)
  · obtain ⟨b₀, hb₀, hb₀s⟩ := (mem_nhdsGT_iff_exists_Ioo_subset' htu).1
      (hh.eventually (gt_mem_nhds hc))
    filter_upwards [Ioo_mem_nhdsGT hb₀] with b hb
    obtain ⟨s, hts, hsb⟩ := exists_between hb.1
    exact (iInf₂_le s ⟨hts, hsb⟩).trans_lt (hb₀s ⟨hts, hsb.trans hb.2⟩)

namespace SkorokhodSpace

variable {E : Type*} [PseudoEMetricSpace E]

/-- For a continuous `g : E → ℝ≥0∞` and `a b ∈ I`, the functional `x ↦ ⨅ s ∈ (a, b), g (x s)` is
upper semicontinuous on the Skorokhod space. -/
lemma upperSemicontinuous_iInf_Ioo {g : E → ℝ≥0∞} (hg : Continuous g) (a b : I) :
    UpperSemicontinuous fun x : SkorokhodSpace E ↦ ⨅ s ∈ Ioo a b, g (x s) := by
  intro x c hc
  simp only [iInf_lt_iff] at hc
  obtain ⟨s, hs, hgs⟩ := hc
  obtain ⟨η, hη, hηg⟩ := EMetric.mem_nhds_iff.1 (hg.continuousAt.eventually (gt_mem_nhds hgs))
  obtain ⟨η', hη', hη's⟩ := EMetric.mem_nhds_iff.1 (isOpen_Ioo.mem_nhds hs)
  filter_upwards [eball_mem_nhds x (lt_min hη hη')] with y hy
  obtain ⟨φ, hφ, hyx⟩ := exists_timeChange_of_edist_lt (mem_eball.1 hy)
  have hφs : φ (φ.symm s) = s := φ.apply_symm_apply s
  have hmem : φ.symm s ∈ Ioo a b := hη's <| by
    rw [mem_eball, edist_comm]
    simpa [hφs] using (hφ (φ.symm s)).trans_le (min_le_right _ _)
  refine (iInf₂_le _ hmem).trans_lt (hηg ?_)
  simpa [hφs] using (hyx (φ.symm s)).trans_le (min_le_left _ _)

/-- The Borel σ-algebra of the Skorokhod `J₁` topology. -/
noncomputable instance instMeasurableSpace : MeasurableSpace (SkorokhodSpace E) := borel _

instance instBorelSpace : BorelSpace (SkorokhodSpace E) := ⟨rfl⟩

lemma continuous_apply_zero : Continuous fun x : SkorokhodSpace E ↦ x 0 :=
  continuous_iff_continuousAt.2 fun _ ↦ tendsto_apply_zero tendsto_id

lemma continuous_apply_one : Continuous fun x : SkorokhodSpace E ↦ x 1 :=
  continuous_iff_continuousAt.2 fun _ ↦ tendsto_apply_one tendsto_id

/-- For a continuous `g : E → ℝ≥0∞`, the map `x ↦ g (x t)` is Borel measurable on the Skorokhod
space. -/
lemma measurable_comp_apply {g : E → ℝ≥0∞} (hg : Continuous g) (t : I) :
    Measurable fun x : SkorokhodSpace E ↦ g (x t) := by
  rcases eq_or_lt_of_le (le_top : t ≤ ⊤) with rfl | ht
  · exact (hg.comp continuous_apply_one).measurable
  · have : NeBot (𝓝[>] t) := nhdsGT_neBot_of_exists_gt ⟨⊤, ht⟩
    refine measurable_of_tendsto_metrizable' (𝓝[>] t)
      (fun b ↦ (upperSemicontinuous_iInf_Ioo hg t b).measurable) (tendsto_pi_nhds.2 fun x ↦ ?_)
    exact tendsto_iInf_Ioo_nhdsGT ht
      (hg.continuousAt.comp_continuousWithinAt (x.isRightContinuous t))

/-- **Billingsley, Theorem 12.5.** The coordinate projections `π_t : x ↦ x t` of the Skorokhod
space are Borel measurable. -/
theorem measurable_apply [MeasurableSpace E] [BorelSpace E] (t : I) :
    Measurable fun x : SkorokhodSpace E ↦ x t := by
  refine measurable_of_isClosed fun F hF ↦ ?_
  have : (fun x : SkorokhodSpace E ↦ x t) ⁻¹' F =
      (fun x : SkorokhodSpace E ↦ infEDist (x t) F) ⁻¹' {0} := by
    ext x
    simp [mem_iff_infEDist_zero_of_closed hF]
  rw [this]
  exact measurable_comp_apply continuous_infEDist t (measurableSet_singleton 0)

/-- The coercion from the Skorokhod space to functions `I → E` is measurable for the product
σ-algebra: the σ-algebra generated by the coordinate projections is contained in the Borel
σ-algebra. -/
theorem measurable_coeFn [MeasurableSpace E] [BorelSpace E] :
    Measurable fun x : SkorokhodSpace E ↦ (x : I → E) :=
  measurable_pi_iff.2 measurable_apply

/-! ### The Borel σ-algebra is generated by the projections -/

section Grid

variable (n : ℕ)

/-- The index `⌊(n + 1) t⌋` of the grid cell `[j / (n + 1), (j + 1) / (n + 1))` containing `t`. -/
private noncomputable def gridIndex (t : I) : Fin (n + 2) :=
  ⟨⌊(n + 1 : ℝ) * t⌋₊, Nat.lt_succ_of_le (Nat.floor_le_of_le (by
    have := t.2.2
    push_cast
    nlinarith [t.2.1]))⟩

/-- The grid point `j / (n + 1)`. -/
private noncomputable def gridPoint (j : Fin (n + 2)) : I :=
  ⟨(j : ℝ) / (n + 1), div_nonneg j.1.cast_nonneg (by positivity),
    (div_le_one (by positivity)).2 (by exact_mod_cast Nat.lt_succ_iff.1 j.2)⟩

/-- The largest grid point `≤ t`. -/
private noncomputable def gridFloor (t : I) : I := gridPoint n (gridIndex n t)

/-- The smallest grid point `≥ t`. -/
private noncomputable def gridCeil (t : I) : I :=
  ⟨(⌈(n + 1 : ℝ) * t⌉₊ : ℝ) / (n + 1), div_nonneg (Nat.cast_nonneg _) (by positivity),
    (div_le_one (by positivity)).2 (by
      have : (⌈(n + 1 : ℝ) * t⌉₊ : ℝ) ≤ ((n + 1 : ℕ) : ℝ) := by
        exact_mod_cast Nat.ceil_le.2 (by push_cast; nlinarith [t.2.1, t.2.2])
      exact_mod_cast this)⟩

variable {n}

private lemma hN (n : ℕ) : (0 : ℝ) < n + 1 := by positivity

private lemma coe_gridFloor (t : I) :
    (gridFloor n t : ℝ) = (⌊(n + 1 : ℝ) * t⌋₊ : ℝ) / (n + 1) := rfl

private lemma coe_gridCeil (t : I) :
    (gridCeil n t : ℝ) = (⌈(n + 1 : ℝ) * t⌉₊ : ℝ) / (n + 1) := rfl

private lemma gridFloor_le (t : I) : gridFloor n t ≤ t := by
  rw [← Subtype.coe_le_coe, coe_gridFloor, div_le_iff₀ (hN n)]
  exact (Nat.floor_le (mul_nonneg (hN n).le t.2.1)).trans_eq (mul_comm _ _)

private lemma le_gridCeil (t : I) : t ≤ gridCeil n t := by
  rw [← Subtype.coe_le_coe, coe_gridCeil, le_div_iff₀ (hN n)]
  exact (mul_comm _ _).trans_le (Nat.le_ceil _)

private lemma gridCeil_sub_lt (t : I) : (gridCeil n t : ℝ) - t < 1 / (n + 1) := by
  rw [coe_gridCeil, div_sub' (hN n).ne', div_lt_div_iff_of_pos_right (hN n)]
  linarith [Nat.ceil_lt_add_one (R := ℝ) (mul_nonneg (hN n).le t.2.1)]

private lemma gridFloor_mono : Monotone (gridFloor n) := fun t t' h ↦ by
  rw [← Subtype.coe_le_coe, coe_gridFloor, coe_gridFloor]
  gcongr

private lemma gridCeil_mono : Monotone (gridCeil n) := fun t t' h ↦ by
  rw [← Subtype.coe_le_coe, coe_gridCeil, coe_gridCeil]
  gcongr

private lemma gridFloor_gridCeil (t : I) : gridFloor n (gridCeil n t) = gridCeil n t := by
  rw [← Subtype.coe_inj, coe_gridFloor, coe_gridCeil, mul_div_cancel₀ _ (hN n).ne',
    Nat.floor_natCast]

private lemma gridCeil_gridFloor (t : I) : gridCeil n (gridFloor n t) = gridFloor n t := by
  rw [← Subtype.coe_inj, coe_gridCeil, coe_gridFloor, mul_div_cancel₀ _ (hN n).ne',
    Nat.ceil_natCast]

private lemma gridCeil_le_gridFloor {r t : I} (h : gridCeil n r ≤ t) :
    gridCeil n r ≤ gridFloor n t :=
  gridFloor_gridCeil (n := n) r ▸ gridFloor_mono h

private lemma gridFloor_lt_of_lt_gridCeil {r t : I} (h : gridFloor n t < gridCeil n r) :
    gridFloor n t < r := by
  by_contra! hr
  exact (gridCeil_gridFloor (n := n) t ▸ gridCeil_mono hr).not_gt h

private lemma eventually_gridIndex_nhdsGE (t : I) :
    ∀ᶠ s in 𝓝[≥] t, gridIndex n s = gridIndex n t := by
  have hlt : (n + 1 : ℝ) * t < ⌊(n + 1 : ℝ) * t⌋₊ + 1 := Nat.lt_floor_add_one _
  have hopen : {s : I | (n + 1 : ℝ) * s < ⌊(n + 1 : ℝ) * t⌋₊ + 1} ∈ 𝓝 t :=
    (isOpen_lt (by fun_prop) continuous_const).mem_nhds hlt
  filter_upwards [nhdsWithin_le_nhds hopen, self_mem_nhdsWithin] with s hs hts
  refine Fin.ext ((Nat.floor_eq_iff (mul_nonneg (hN n).le s.2.1)).2 ⟨?_, hs⟩)
  exact (Nat.floor_le (mul_nonneg (hN n).le t.2.1)).trans
    (mul_le_mul_of_nonneg_left (Subtype.coe_le_coe.2 hts) (hN n).le)

private lemma exists_eventually_gridIndex_nhdsLT (t : I) :
    ∃ c, ∀ᶠ s in 𝓝[<] t, gridIndex n s = c := by
  rcases eq_or_lt_of_le (bot_le : ⊥ ≤ t) with rfl | ht
  · exact ⟨gridIndex n ⊥, by simp⟩
  have ht' : (0 : ℝ) < (n + 1 : ℝ) * t := mul_pos (hN n) (show (0 : ℝ) < t from ht)
  have hc1 : 1 ≤ ⌈(n + 1 : ℝ) * t⌉₊ := Nat.one_le_iff_ne_zero.2 (Nat.ceil_pos.2 ht').ne'
  set c := ⌈(n + 1 : ℝ) * t⌉₊ - 1 with hc
  have hcR : (c : ℝ) = ⌈(n + 1 : ℝ) * t⌉₊ - 1 := by rw [hc, Nat.cast_sub hc1, Nat.cast_one]
  have hct : (c : ℝ) < (n + 1 : ℝ) * t := by
    rw [hcR]; linarith [Nat.ceil_lt_add_one ht'.le]
  have hopen : {s : I | (c : ℝ) < (n + 1 : ℝ) * s} ∈ 𝓝 t :=
    (isOpen_lt continuous_const (by fun_prop)).mem_nhds hct
  have hceil : ⌈(n + 1 : ℝ) * t⌉₊ ≤ n + 1 :=
    Nat.ceil_le.2 (by push_cast; nlinarith [t.2.1, t.2.2])
  refine ⟨⟨c, by omega⟩, ?_⟩
  filter_upwards [nhdsWithin_le_nhds hopen, self_mem_nhdsWithin] with s hs hst
  refine Fin.ext ((Nat.floor_eq_iff (mul_nonneg (hN n).le s.2.1)).2 ⟨hs.le, ?_⟩)
  have : (n + 1 : ℝ) * s < (n + 1) * t :=
    mul_lt_mul_of_pos_left (show (s : ℝ) < t from hst) (hN n)
  rw [hcR]
  linarith [Nat.le_ceil ((n + 1 : ℝ) * t)]

/-- Composing with the grid index gives càdlàg step functions. -/
private lemma isCadlag_comp_gridIndex {E : Type*} [TopologicalSpace E] (v : Fin (n + 2) → E) :
    IsCadlag (v ∘ gridIndex n) where
  isRightContinuous t := tendsto_const_nhds.congr' <|
    ((eventually_gridIndex_nhdsGE (n := n) t).filter_mono
      (nhdsWithin_mono _ Ioi_subset_Ici_self)).mono fun s hs ↦ by simp [hs]
  tendsto_nhdsLT t := by
    obtain ⟨c, hc⟩ := exists_eventually_gridIndex_nhdsLT (n := n) t
    exact ⟨v c, tendsto_const_nhds.congr' (hc.mono fun s hs ↦ by simp [hs])⟩

private lemma gridCeil_zero : gridCeil n 0 = 0 := by
  rw [← Subtype.coe_inj, coe_gridCeil]
  simp

private lemma gridCeil_one : gridCeil n 1 = 1 := by
  rw [← Subtype.coe_inj, coe_gridCeil]
  have : ((n : ℝ) + 1) * ((1 : I) : ℝ) = ((n + 1 : ℕ) : ℝ) := by push_cast; ring
  rw [this, Nat.ceil_natCast]
  push_cast
  exact div_self (hN n).ne'

end Grid

/-- The step function with value `v j` on the `j`-th grid cell `[j / (n + 1), (j + 1) / (n + 1))`.
-/
private noncomputable def stepMap (n : ℕ) (v : Fin (n + 2) → E) : SkorokhodSpace E :=
  ⟨v ∘ gridIndex n, isCadlag_comp_gridIndex v⟩

private lemma continuous_stepMap (n : ℕ) : Continuous (stepMap (E := E) n) :=
  (LipschitzWith.of_edist_le fun v v' ↦
    edist_le_of_forall_edist_le fun _ ↦ edist_le_pi_edist v v' _).continuous

/-- The grid approximation `t ↦ x (⌊(n + 1) t⌋ / (n + 1))` of `x`. -/
private noncomputable def gridApprox (n : ℕ) (x : SkorokhodSpace E) : SkorokhodSpace E :=
  stepMap n fun j ↦ x (gridPoint n j)

private lemma gridApprox_apply (n : ℕ) (x : SkorokhodSpace E) (t : I) :
    gridApprox n x t = x (gridFloor n t) := rfl

private lemma exists_pos_separated (S : Finset I) :
    ∃ η > (0 : ℝ), ∀ a ∈ S, ∀ b ∈ S, a ≠ b → 4 * η ≤ dist a b := by
  classical
  set P := (S ×ˢ S).filter fun p : I × I ↦ p.1 ≠ p.2
  rcases P.eq_empty_or_nonempty with hP | hP
  · refine ⟨1, one_pos, fun a ha b hb hab ↦ ?_⟩
    have : (a, b) ∈ P := Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨ha, hb⟩, hab⟩
    simp [hP] at this
  · obtain ⟨p₀, hp₀, hmin⟩ := P.exists_min_image (fun p ↦ dist p.1 p.2) hP
    have hne := dist_pos.2 (Finset.mem_filter.1 hp₀).2
    refine ⟨dist p₀.1 p₀.2 / 4, by positivity, fun a ha b hb hab ↦ ?_⟩
    have := hmin (a, b) (Finset.mem_filter.2 ⟨Finset.mem_product.2 ⟨ha, hb⟩, hab⟩)
    linarith

/-- The grid approximations of a càdlàg function converge to it in the Skorokhod topology
([Billingsley, §12][billingsley1999]). -/
private lemma tendsto_gridApprox (x : SkorokhodSpace E) :
    Tendsto (fun n ↦ gridApprox n x) atTop (𝓝 x) := by
  classical
  refine EMetric.tendsto_atTop.2 fun ε hε ↦ ?_
  obtain ⟨ε₁, hε₁, hε₁ε⟩ := exists_between hε
  have hε₁r : 0 < ε₁.toReal := ENNReal.toReal_pos hε₁.ne' hε₁ε.ne_top
  obtain ⟨s, hs⟩ := x.isCadlag.exists_finset_edist_lt hε₁
  obtain ⟨η, hη, hsep⟩ := exists_pos_separated (insert 0 (insert 1 s))
  obtain ⟨N, hN'⟩ := exists_nat_gt (max (1 / η) (s.card / ε₁.toReal))
  refine ⟨N, fun n hn ↦ ?_⟩
  have hn1 : (N : ℝ) ≤ n := by exact_mod_cast hn
  have hmesh : 1 / ((n : ℝ) + 1) < η := by
    rw [div_lt_iff₀ (hN n)]
    have := (le_max_left _ _).trans_lt hN'
    rw [div_lt_iff₀ hη] at this
    nlinarith
  have hcard : (s.card : ℝ) / (n + 1) < ε₁.toReal := by
    rw [div_lt_iff₀ (hN n)]
    have := (le_max_right _ _).trans_lt hN'
    rw [div_lt_iff₀ hε₁r] at this
    nlinarith
  set R := s.filter fun r ↦ gridCeil n r ≠ r
  have hdist (r : I) : dist (gridCeil n r) r < 1 / (n + 1) := by
    rw [Subtype.dist_eq, Real.dist_eq,
      abs_of_nonneg (sub_nonneg.2 (Subtype.coe_le_coe.2 (le_gridCeil r)))]
    exact gridCeil_sub_lt r
  have hmemS {r : I} (hr : r ∈ s) : r ∈ insert 0 (insert 1 s) :=
    Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hr)
  have hR0 (r : I) (hr : r ∈ R) : 2 * η ≤ (r : ℝ) ∧ (r : ℝ) + 2 * η ≤ 1 := by
    obtain ⟨hrs, hr⟩ := Finset.mem_filter.1 hr
    have h0 : r ≠ 0 := by rintro rfl; exact hr gridCeil_zero
    have h1 : r ≠ 1 := by rintro rfl; exact hr gridCeil_one
    have h0' := hsep r (hmemS hrs) 0 (Finset.mem_insert_self _ _) h0
    have h1' := hsep r (hmemS hrs) 1 (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)) h1
    rw [Subtype.dist_eq, Real.dist_eq] at h0' h1'
    simp only [Icc.coe_zero, sub_zero, Icc.coe_one] at h0' h1'
    rw [abs_of_nonneg r.2.1] at h0'
    rw [abs_of_nonpos (sub_nonpos.2 r.2.2)] at h1'
    constructor <;> linarith
  obtain ⟨φ, hφR, hφfix, hφdist⟩ := unitInterval.exists_orderIso_apply_eq_of_separated R
    (gridCeil n) hR0
    (fun r hr r' hr' hne ↦ hsep r (hmemS (Finset.mem_filter.1 hr).1) r'
      (hmemS (Finset.mem_filter.1 hr').1) hne)
    (fun r _ ↦ (hdist r).trans hmesh)
  have hφs (r : I) (hr : r ∈ s) : φ r = gridCeil n r := by
    by_cases hrR : r ∈ R
    · exact hφR r hrR
    · have hc : gridCeil n r = r := by
        by_contra h
        exact hrR (Finset.mem_filter.2 ⟨hr, h⟩)
      rw [hc]
      refine hφfix r fun r' hr' ↦ ?_
      have := hsep r (hmemS hr) r' (hmemS (Finset.mem_filter.1 hr').1)
        fun h ↦ hrR (h ▸ hr')
      linarith
  have hφd (t : I) : dist (φ t) t ≤ s.card / (n + 1) := by
    refine (hφdist t).trans ((Finset.sum_le_sum fun r _ ↦ (hdist r).le).trans ?_)
    rw [Finset.sum_const, nsmul_eq_mul, mul_one_div]
    gcongr
    exact Finset.filter_subset _ _
  rw [edist_comm, edist_def]
  refine (skorokhodEDist_le_of_forall φ (fun t ↦ ?_) (fun t ↦ ?_)).trans_lt hε₁ε
  · rw [edist_dist]
    exact ENNReal.ofReal_le_of_le_toReal ((hφd t).trans hcard.le)
  rw [gridApprox_apply]
  -- `t` and `p = ⌊φ t⌋` lie in the same cell of the partition given by `s`.
  set p := gridFloor n (φ t)
  have hiff (r : I) (hr : r ∈ s) : r ≤ t ↔ r ≤ p := by
    constructor
    · intro h
      refine (le_gridCeil r).trans (gridCeil_le_gridFloor ?_)
      rw [← hφs r hr]
      exact φ.monotone h
    · intro h
      by_contra! h'
      refine (not_le.2 (gridFloor_lt_of_lt_gridCeil ((gridFloor_le (φ t)).trans_lt ?_))) h
      rw [← hφs r hr]
      exact φ.strictMono h'
  rcases le_total t p with htp | hpt
  · refine (hs t p htp fun r hr ↦ ?_).le
    rcases le_or_gt r t with h | h
    · exact Or.inl h
    · exact Or.inr (lt_of_not_ge fun h' ↦ (not_le.2 h) ((hiff r hr).2 h'))
  · rw [edist_comm]
    refine (hs p t hpt fun r hr ↦ ?_).le
    rcases le_or_gt r p with h | h
    · exact Or.inl h
    · exact Or.inr (lt_of_not_ge fun h' ↦ (not_le.2 h) ((hiff r hr).1 h'))

/-- The grid approximations are measurable for the σ-algebra generated by the projections. -/
private lemma measurable_gridApprox_comap [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E] (n : ℕ) :
    @Measurable _ _ (MeasurableSpace.comap (fun x : SkorokhodSpace E ↦ (x : I → E))
      MeasurableSpace.pi) _ (gridApprox (E := E) n) := by
  refine @Measurable.comp _ _ _
    (MeasurableSpace.comap (fun x : SkorokhodSpace E ↦ (x : I → E)) MeasurableSpace.pi) _ _ _
    (fun x : SkorokhodSpace E ↦ fun j : Fin (n + 2) ↦ x (gridPoint n j))
    (continuous_stepMap n).measurable ?_
  exact (Measurable.of_eval fun j ↦ measurable_pi_apply (gridPoint n j)).comp
    (comap_measurable _)

/-- **Billingsley, Theorem 12.5.** The Borel σ-algebra of the Skorokhod `J₁` topology is the
σ-algebra generated by the coordinate projections `π_t : x ↦ x t`, i.e. the pullback of the
product σ-algebra along the coercion `D([0, 1], E) → (I → E)`. -/
theorem measurableSpace_eq_comap_coeFn [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E] :
    (instMeasurableSpace : MeasurableSpace (SkorokhodSpace E)) =
      MeasurableSpace.comap (fun x : SkorokhodSpace E ↦ (x : I → E)) MeasurableSpace.pi := by
  refine le_antisymm (fun s hs ↦ ?_) measurable_coeFn.comap_le
  exact @measurable_of_tendsto_metrizable _ _
    (MeasurableSpace.comap (fun x : SkorokhodSpace E ↦ (x : I → E)) MeasurableSpace.pi)
    _ _ _ _ _ id measurable_gridApprox_comap (tendsto_pi_nhds.2 tendsto_gridApprox) s hs

/-- The Borel σ-algebra of the Skorokhod space is generated by the coordinate projections. -/
theorem measurableSpace_eq_iSup_comap [MeasurableSpace E] [BorelSpace E]
    [SecondCountableTopology E] :
    (instMeasurableSpace : MeasurableSpace (SkorokhodSpace E)) =
      ⨆ t : I, MeasurableSpace.comap (fun x : SkorokhodSpace E ↦ x t) ‹MeasurableSpace E› := by
  rw [measurableSpace_eq_comap_coeFn, MeasurableSpace.pi, MeasurableSpace.comap_iSup]
  simp_rw [MeasurableSpace.comap_comp]
  rfl

end SkorokhodSpace
