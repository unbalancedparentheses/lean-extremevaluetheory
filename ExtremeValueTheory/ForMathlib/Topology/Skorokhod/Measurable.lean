/-!
# The coordinate projections of the Skorokhod space are Borel measurable

We equip the Skorokhod space `D([0, 1], E)` with its Borel σ-algebra for the `J₁` topology and
show that the coordinate projections `π_t : x ↦ x t` are measurable
([Billingsley, *Convergence of Probability Measures*, Theorem 12.5][billingsley1999]).

The projections `π_0` and `π_1` are continuous, but for `0 < t < 1` the projection `π_t` is
discontinuous at every `x` that jumps at `t`. Billingsley's proof for real valued paths uses the
continuous functionals `x ↦ ε⁻¹ ∫_t^{t+ε} x`. We instead use, for a continuous `g : E → ℝ≥0∞`,
the functionals `x ↦ ⨅ s ∈ (t, b), g (x s)`. These are upper semicontinuous on `D`, hence Borel,
and by right continuity they converge to `g (x t)` as `b ↓ t`. Taking `g` to be the distance to
a closed set gives the measurability of `π_t`.

## Main statements

* `SkorokhodSpace.upperSemicontinuous_iInf_Ioo`: `x ↦ ⨅ s ∈ (a, b), g (x s)` is upper
  semicontinuous on `D` for continuous `g`.
* `SkorokhodSpace.measurable_apply`: the projections `π_t` are Borel measurable.
* `SkorokhodSpace.measurable_coeFn`: the map `D → (I → E)` is measurable for the product
  σ-algebra, i.e. the σ-algebra generated by the projections is contained in the Borel σ-algebra.

## References

* [P. Billingsley, *Convergence of Probability Measures*][billingsley1999]
-/

@[expose] public section

open Filter Set Topology Metric unitInterval
open scoped ENNReal

/-- If `h` is right-continuous at `t`, then `⨅ s ∈ (t, b), h s` tends to `h t` as `b ↓ t`. -/
lemma tendsto_iInf_Ioo_nhdsGT {X β : Type*} [LinearOrder X] [DenselyOrdered X]
    [TopologicalSpace X] [OrderTopology X] [CompleteLinearOrder β] [TopologicalSpace β]
    [OrderTopology β] [DenselyOrdered β] {h : X → β} {t u : X} (htu : t < u)
    (hh : ContinuousWithinAt h (Ioi t) t) :
    Tendsto (fun b ↦ ⨅ s ∈ Ioo t b, h s) (𝓝[>] t) (𝓝 (h t)) := by
  refine tendsto_order.2 ⟨fun a ha ↦ ?_, fun c hc ↦ ?_⟩
  · obtain ⟨a', haa', ha't⟩ := exists_between ha
    obtain ⟨b₀, hb₀, hb₀s⟩ := (mem_nhdsGT_iff_exists_Ioo_subset' htu).1
      (hh.eventually (lt_mem_nhds ha't))
    filter_upwards [Ioo_mem_nhdsGT hb₀] with b hb
    exact haa'.trans_le (le_iInf₂ fun s hs ↦ (hb₀s ⟨hs.1, hs.2.trans hb.2⟩).le)
  · obtain ⟨b₀, hb₀, hb₀s⟩ := (mem_nhdsGT_iff_exists_Ioo_subset' htu).1
      (hh.eventually (gt_mem_nhds hc))
    filter_upwards [Ioo_mem_nhdsGT hb₀] with b hb
    obtain ⟨s, hts, hsb⟩ := exists_between hb.1
    exact (iInf₂_le s ⟨hts, hsb⟩).trans_lt (hb₀s ⟨hts, hsb.trans hb.2⟩)

namespace SkorokhodSpace

variable {E : Type*} [PseudoEMetricSpace E]

/-- For a continuous `g : E → ℝ≥0∞` and `a b ∈ I`, the functional `x ↦ ⨅ s ∈ (a, b), g (x s)` is
upper semicontinuous on the Skorokhod space. -/
lemma upperSemicontinuous_iInf_Ioo {g : E → ℝ≥0∞} (hg : Continuous g) (a b : I) :
    UpperSemicontinuous fun x : SkorokhodSpace E ↦ ⨅ s ∈ Ioo a b, g (x s) := by
  intro x c hc
  simp only [iInf_lt_iff] at hc
  obtain ⟨s, hs, hgs⟩ := hc
  obtain ⟨η, hη, hηg⟩ := EMetric.mem_nhds_iff.1 (hg.continuousAt.eventually (gt_mem_nhds hgs))
  obtain ⟨η', hη', hη's⟩ := EMetric.mem_nhds_iff.1 (isOpen_Ioo.mem_nhds hs)
  filter_upwards [eball_mem_nhds x (lt_min hη hη')] with y hy
  obtain ⟨φ, hφ, hyx⟩ := exists_timeChange_of_edist_lt (mem_eball.1 hy)
  have hφs : φ (φ.symm s) = s := φ.apply_symm_apply s
  have hmem : φ.symm s ∈ Ioo a b := hη's <| by
    rw [mem_eball, edist_comm]
    simpa [hφs] using (hφ (φ.symm s)).trans_le (min_le_right _ _)
  refine (iInf₂_le _ hmem).trans_lt (hηg ?_)
  simpa [hφs] using (hyx (φ.symm s)).trans_le (min_le_left _ _)

/-- The Borel σ-algebra of the Skorokhod `J₁` topology. -/
noncomputable instance instMeasurableSpace : MeasurableSpace (SkorokhodSpace E) := borel _

instance instBorelSpace : BorelSpace (SkorokhodSpace E) := ⟨rfl⟩

lemma continuous_apply_zero : Continuous fun x : SkorokhodSpace E ↦ x 0 :=
  continuous_iff_continuousAt.2 fun _ ↦ tendsto_apply_zero tendsto_id

lemma continuous_apply_one : Continuous fun x : SkorokhodSpace E ↦ x 1 :=
  continuous_iff_continuousAt.2 fun _ ↦ tendsto_apply_one tendsto_id

/-- For a continuous `g : E → ℝ≥0∞`, the map `x ↦ g (x t)` is Borel measurable on the Skorokhod
space. -/
lemma measurable_comp_apply {g : E → ℝ≥0∞} (hg : Continuous g) (t : I) :
    Measurable fun x : SkorokhodSpace E ↦ g (x t) := by
  rcases eq_or_lt_of_le (le_top : t ≤ ⊤) with rfl | ht
  · exact (hg.comp continuous_apply_one).measurable
  · have : NeBot (𝓝[>] t) := nhdsGT_neBot_of_exists_gt ⟨⊤, ht⟩
    refine measurable_of_tendsto_metrizable' (𝓝[>] t)
      (fun b ↦ (upperSemicontinuous_iInf_Ioo hg t b).measurable) (tendsto_pi_nhds.2 fun x ↦ ?_)
    exact tendsto_iInf_Ioo_nhdsGT ht
      (hg.continuousAt.comp_continuousWithinAt (x.isRightContinuous t))

/-- **Billingsley, Theorem 12.5.** The coordinate projections `π_t : x ↦ x t` of the Skorokhod
space are Borel measurable. -/
theorem measurable_apply [MeasurableSpace E] [BorelSpace E] (t : I) :
    Measurable fun x : SkorokhodSpace E ↦ x t := by
  refine measurable_of_isClosed fun F hF ↦ ?_
  have : (fun x : SkorokhodSpace E ↦ x t) ⁻¹' F =
      (fun x : SkorokhodSpace E ↦ infEDist (x t) F) ⁻¹' {0} := by
    ext x
    simp [mem_iff_infEDist_zero_of_closed hF]
  rw [this]
  exact measurable_comp_apply continuous_infEDist t (measurableSet_singleton 0)

/-- The coercion from the Skorokhod space to functions `I → E` is measurable for the product
σ-algebra: the σ-algebra generated by the coordinate projections is contained in the Borel
σ-algebra. -/
theorem measurable_coeFn [MeasurableSpace E] [BorelSpace E] :
    Measurable fun x : SkorokhodSpace E ↦ (x : I → E) :=
  measurable_pi_iff.2 measurable_apply

end SkorokhodSpace
