/-!
# Laws on the Skorokhod space

Tools for weak convergence of probability measures on the Skorokhod space `D([0, 1], E)`
([Billingsley, *Convergence of Probability Measures*, §12–13][billingsley1999]).

* The finite-dimensional distributions at the times of a dense set `T` containing `1` determine
  a finite measure on `D`: the Borel σ-algebra is generated by the projections at the times of
  `T`, since `x t = lim x s` as `s ↓ t` by right continuity.
* The projection `π_J : x ↦ (x t)_{t ∈ J}` is continuous at every path continuous at the times
  of `J`.
* The set of fixed discontinuities `{t | μ {x | x is discontinuous at t} ≠ 0}` of a finite
  measure `μ` is countable: for fixed `ε, η > 0` only finitely many times carry a jump larger
  than `ε` with probability larger than `η`, because each càdlàg path has finitely many jumps
  larger than `ε`.
* A general continuous mapping theorem for maps that are continuous almost everywhere for the
  limit measure.

## Main statements

* `MeasureTheory.ProbabilityMeasure.tendsto_map_of_ae_continuousAt`: the continuous mapping
  theorem for almost everywhere continuous maps.
* `SkorokhodSpace.continuousAt_restrict`, `SkorokhodSpace.measurable_restrict`: continuity and
  measurability of the finite-dimensional projections.
* `SkorokhodSpace.measurableSpace_eq_comap_restrict`: the Borel σ-algebra is generated by the
  projections at the times of a dense set containing `1` (Billingsley, Theorem 12.5).
* `SkorokhodSpace.ext_of_forall_map_restrict_eq`: finite-dimensional distributions on such a set
  determine a finite measure.
* `SkorokhodSpace.countable_setOf_measure_not_continuousAt_ne_zero`: fixed discontinuities are
  countable (Billingsley, §13).

## References

* [P. Billingsley, *Convergence of Probability Measures*][billingsley1999]
-/

@[expose] public section

open Filter Set Topology MeasureTheory
open scoped ENNReal

namespace MeasureTheory.ProbabilityMeasure

variable {X Y : Type*} [TopologicalSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
  [HasOuterApproxClosed X] [TopologicalSpace Y] [MeasurableSpace Y] [OpensMeasurableSpace Y]

/-- **Continuous mapping theorem** for maps that are continuous almost everywhere for the limit
measure. -/
theorem tendsto_map_of_ae_continuousAt {μs : ℕ → ProbabilityMeasure X}
    {μ : ProbabilityMeasure X} (h : Tendsto μs atTop (𝓝 μ)) {f : X → Y} (hf : Measurable f)
    (hcont : ∀ᵐ x ∂(μ : Measure X), ContinuousAt f x) :
    Tendsto (fun n ↦ (μs n).map f) atTop (𝓝 (μ.map f)) := by
  refine tendsto_of_forall_isOpen_le_liminf_nat' fun G hG ↦ ?_
  simp only [toMeasure_map]
  rw [Measure.map_apply hf hG.measurableSet]
  simp_rw [Measure.map_apply hf hG.measurableSet]
  have hsub : f ⁻¹' G ⊆ interior (f ⁻¹' G) ∪ {x | ¬ ContinuousAt f x} := by
    intro x hx
    by_cases hc : ContinuousAt f x
    · exact Or.inl (mem_interior_iff_mem_nhds.2 (hc.preimage_mem_nhds (hG.mem_nhds hx)))
    · exact Or.inr hc
  have hnull : (μ : Measure X) {x | ¬ ContinuousAt f x} = 0 := by
    rw [← ae_iff]; exact hcont
  calc (μ : Measure X) (f ⁻¹' G) ≤ (μ : Measure X) (interior (f ⁻¹' G)) := by
        refine (measure_mono hsub).trans ((measure_union_le _ _).trans ?_)
        rw [hnull, add_zero]
    _ ≤ atTop.liminf fun n ↦ (μs n : Measure X) (interior (f ⁻¹' G)) :=
        le_liminf_measure_open_of_tendsto h isOpen_interior
    _ ≤ atTop.liminf fun n ↦ (μs n : Measure X) (f ⁻¹' G) :=
        liminf_le_liminf (Eventually.of_forall fun n ↦ measure_mono interior_subset)

end MeasureTheory.ProbabilityMeasure

namespace SkorokhodSpace

open unitInterval

variable {E : Type*}

section Continuity

variable [PseudoEMetricSpace E]

/-- The finite-dimensional projection `x ↦ (x t)_{t ∈ J}` is continuous at every path that is
continuous at each time of `J`. -/
lemma continuousAt_restrict {J : Finset I} {x : SkorokhodSpace E}
    (hx : ∀ t ∈ J, ContinuousAt x t) :
    ContinuousAt (fun y : SkorokhodSpace E ↦ fun t : J ↦ y t) x :=
  continuousAt_pi.2 fun t ↦
    tendsto_apply_of_continuousAt (x := fun y : SkorokhodSpace E ↦ y) tendsto_id (hx t t.2)

variable [MeasurableSpace E] [BorelSpace E]

/-- The finite-dimensional projections are measurable. -/
lemma measurable_restrict (S : Set I) :
    Measurable fun y : SkorokhodSpace E ↦ fun t : S ↦ y t :=
  measurable_pi_iff.2 fun t ↦ measurable_apply t

end Continuity

section Generate

variable [PseudoEMetricSpace E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]

/-- A point `t < 1` of the unit interval is the limit from the right of points of a dense
set `T`. -/
lemma exists_seq_mem_tendsto_nhdsGT {T : Set I} (hT : Dense T) {t : I} (ht : t < 1) :
    ∃ s : ℕ → I, (∀ m, s m ∈ T) ∧ Tendsto s atTop (𝓝[>] t) := by
  have hne (m : ℕ) : ({u : I | t < u ∧ (u : ℝ) < t + 1 / (m + 1)} : Set I).Nonempty := by
    have ht' : (t : ℝ) < 1 := ht
    have hpos : (0 : ℝ) < 1 / (m + 1) := by positivity
    set v : ℝ := min ((t : ℝ) + 1 / (m + 1) / 2) ((t + 1) / 2)
    have hv1 : (t : ℝ) < v := lt_min (by linarith) (by linarith)
    have hv2 : v ≤ 1 := (min_le_right _ _).trans (by linarith)
    refine ⟨⟨v, (t.2.1).trans hv1.le, hv2⟩, hv1, ?_⟩
    exact (min_le_left _ _).trans_lt (by linarith)
  have hopen (m : ℕ) : IsOpen ({u : I | t < u ∧ (u : ℝ) < t + 1 / (m + 1)} : Set I) :=
    (isOpen_lt continuous_const continuous_id).inter
      (isOpen_lt continuous_subtype_val continuous_const)
  choose s hsT hs using fun m ↦ hT.exists_mem_open (hopen m) (hne m)
  refine ⟨s, hsT, tendsto_nhdsWithin_iff.2 ⟨?_, Eventually.of_forall fun m ↦ (hs m).1⟩⟩
  rw [tendsto_subtype_rng]
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds ?_
    (fun m ↦ (Subtype.coe_lt_coe.2 (hs m).1).le) (fun m ↦ (hs m).2.le)
  simpa using tendsto_one_div_add_atTop_nhds_zero_nat.const_add (t : ℝ)

/-- The Borel σ-algebra of the Skorokhod space is generated by the coordinate projections at
the times of any dense set `T` containing `1` ([Billingsley, Theorem 12.5][billingsley1999]). -/
theorem measurableSpace_eq_comap_restrict {T : Set I} (hT : Dense T) (h1 : (1 : I) ∈ T) :
    (instMeasurableSpace : MeasurableSpace (SkorokhodSpace E)) =
      MeasurableSpace.comap (fun x : SkorokhodSpace E ↦ fun t : T ↦ x t) MeasurableSpace.pi := by
  refine le_antisymm ?_ (measurable_restrict T).comap_le
  set Φ : SkorokhodSpace E → T → E := fun x t ↦ x t
  rw [measurableSpace_eq_iSup_comap]
  refine iSup_le fun t ↦ ?_
  rw [← measurable_iff_comap_le]
  by_cases htT : t ∈ T
  · exact (measurable_pi_apply (⟨t, htT⟩ : T)).comp (comap_measurable Φ)
  have ht : t < 1 := lt_of_le_of_ne le_top fun h ↦ htT (h ▸ h1)
  obtain ⟨s, hsT, hs⟩ := exists_seq_mem_tendsto_nhdsGT hT ht
  refine @measurable_of_tendsto_metrizable _ _ (MeasurableSpace.comap Φ MeasurableSpace.pi) _ _ _
    _ (fun k x ↦ x (s k)) _ (fun k ↦ (measurable_pi_apply (⟨s k, hsT k⟩ : T)).comp
      (comap_measurable Φ)) (tendsto_pi_nhds.2 fun x ↦ ?_)
  exact (x.isRightContinuous t).tendsto.comp hs

/-- **The finite-dimensional distributions on a dense set of times containing `1` determine a
finite measure on the Skorokhod space** ([Billingsley, Theorem 12.5][billingsley1999]). -/
theorem ext_of_forall_map_restrict_eq {μ ν : Measure (SkorokhodSpace E)} [IsFiniteMeasure μ]
    [IsFiniteMeasure ν] {T : Set I} (hT : Dense T) (h1 : (1 : I) ∈ T)
    (h : ∀ J : Finset I, (J : Set I) ⊆ T →
      μ.map (fun x : SkorokhodSpace E ↦ fun t : J ↦ x t) =
        ν.map (fun x : SkorokhodSpace E ↦ fun t : J ↦ x t)) :
    μ = ν := by
  classical
  set Φ : SkorokhodSpace E → T → E := fun x t ↦ x t with hΦ
  have hΦm : Measurable Φ := measurable_restrict T
  have hmap : μ.map Φ = ν.map Φ := by
    refine IsProjectiveLimit.unique (P := fun J ↦ (μ.map Φ).map J.restrict)
      (fun J ↦ rfl) fun J' ↦ ?_
    set J : Finset I := J'.map (Function.Embedding.subtype _)
    have hJT : (J : Set I) ⊆ T := by
      intro t ht
      obtain ⟨u, -, rfl⟩ := Finset.mem_map.1 ht
      exact u.2
    set g : (J → E) → (J' → E) := fun y t ↦
      y ⟨t.1.1, Finset.mem_map.2 ⟨t.1, t.2, rfl⟩⟩
    have hg : Measurable g := measurable_pi_iff.2 fun t ↦ measurable_pi_apply _
    have hcomp : (J'.restrict ∘ Φ) = g ∘ fun x : SkorokhodSpace E ↦ fun t : J ↦ x t := rfl
    have hJm : Measurable fun x : SkorokhodSpace E ↦ fun t : J ↦ x t :=
      measurable_pi_iff.2 fun t ↦ measurable_apply (E := E) t.1
    show (ν.map Φ).map J'.restrict = (μ.map Φ).map J'.restrict
    rw [Measure.map_map (Finset.measurable_restrict _) hΦm,
      Measure.map_map (Finset.measurable_restrict _) hΦm, hcomp,
      ← Measure.map_map hg hJm, ← Measure.map_map hg hJm,
      h J hJT]
  ext s hs
  have hs' : MeasurableSet[MeasurableSpace.comap Φ MeasurableSpace.pi] s := by
    rw [← measurableSpace_eq_comap_restrict hT h1]; exact hs
  obtain ⟨B, hB, rfl⟩ := hs'
  rw [← Measure.map_apply hΦm hB, ← Measure.map_apply hΦm hB, hmap]

end Generate

section FixedDiscontinuities

variable [EMetricSpace E]

/-- A path whose left limit at `t` equals its value at `t` is continuous at `t`. -/
lemma continuousAt_of_edist_leftLim_eq_zero (x : SkorokhodSpace E) {t : I}
    (h : edist (Function.leftLim x t) (x t) = 0) : ContinuousAt x t := by
  rw [edist_eq_zero] at h
  refine continuousAt_iff_continuous_left'_right'.2 ⟨?_, x.isRightContinuous t⟩
  have := x.isCadlag.tendsto_nhdsLT_leftLim t
  rwa [h] at this

/-- The size `edist (x (t-)) (x t)` of the jump of `x` at `t`. -/
noncomputable def jumpEDist (t : I) (x : SkorokhodSpace E) : ℝ≥0∞ :=
  edist (Function.leftLim x t) (x t)

variable [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]

lemma measurable_jumpEDist (t : I) : Measurable (jumpEDist (E := E) t) := by
  rcases eq_bot_or_bot_lt t with rfl | ht
  · have : jumpEDist (E := E) ⊥ = fun _ ↦ 0 := by
      ext x
      rw [jumpEDist, leftLim_eq_of_eq_bot _ (by simp), edist_self]
    rw [this]
    exact measurable_const
  obtain ⟨u, -, hu, hlim⟩ := exists_seq_strictMono_tendsto' ht
  have hu' : Tendsto u atTop (𝓝[<] t) :=
    tendsto_nhdsWithin_iff.2 ⟨hlim, Eventually.of_forall fun n ↦ (hu n).2⟩
  refine measurable_of_tendsto_metrizable (f := fun n x ↦ edist (x (u n)) (x t))
    (fun n ↦ (measurable_apply (u n)).edist (measurable_apply t)) (tendsto_pi_nhds.2 fun x ↦ ?_)
  exact ((x.isCadlag.tendsto_nhdsLT_leftLim t).comp hu').edist tendsto_const_nhds

/-- For a finite measure on the Skorokhod space and `ε, η > 0`, only finitely many times `t`
carry a jump larger than `ε` with probability larger than `η`. -/
lemma finite_setOf_lt_measure_lt_jumpEDist (μ : Measure (SkorokhodSpace E)) [IsFiniteMeasure μ]
    {ε η : ℝ≥0∞} (hε : 0 < ε) (hη : 0 < η) :
    {t : I | η < μ {x | ε < jumpEDist t x}}.Finite := by
  by_contra hS
  set S := {t : I | η < μ {x | ε < jumpEDist t x}}
  let e := (Set.not_finite.1 hS).natEmbedding S
  set τ : ℕ → I := fun i ↦ (e i : I)
  have hτ : Function.Injective τ := Subtype.val_injective.comp e.injective
  set A : I → Set (SkorokhodSpace E) := fun t ↦ {x | ε < jumpEDist t x}
  have hA (t : I) : MeasurableSet (A t) :=
    measurableSet_lt measurable_const (measurable_jumpEDist t)
  set B : ℕ → Set (SkorokhodSpace E) := fun m ↦ ⋃ i ≥ m, A (τ i)
  have hBm (m : ℕ) : MeasurableSet (B m) :=
    MeasurableSet.iUnion fun i ↦ MeasurableSet.iUnion fun _ ↦ hA _
  have hanti : Antitone B := fun m m' hmm' ↦
    iUnion₂_mono' fun i hi ↦ ⟨i, hmm'.trans hi, subset_rfl⟩
  have hempty : (⋂ m, B m) = ∅ := by
    refine eq_empty_of_forall_notMem fun x hx ↦ ?_
    have hfin : {i | x ∈ A (τ i)}.Finite :=
      Set.Finite.preimage (f := τ) hτ.injOn (x.isCadlag.finite_setOf_lt_edist_leftLim hε)
    obtain ⟨m, hm⟩ := hfin.bddAbove
    obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.1 (mem_iInter.1 hx (m + 1))
    exact absurd (hm hxi) (by omega)
  have hlim := tendsto_measure_iInter_atTop (μ := μ) (fun m ↦ (hBm m).nullMeasurableSet) hanti
    ⟨0, measure_ne_top _ _⟩
  rw [hempty, measure_empty] at hlim
  have hge (m : ℕ) : η ≤ (μ ∘ B) m :=
    ((e m).2 : η < μ (A (τ m))).le.trans (measure_mono (subset_iUnion₂ (s := fun i _ ↦ A (τ i)) m
      le_rfl))
  exact (not_le.2 hη) (ge_of_tendsto' hlim hge)

/-- **The fixed discontinuities of a finite measure on the Skorokhod space are countable**:
the set of times `t` at which the paths are discontinuous with positive probability is
countable ([Billingsley, §13][billingsley1999]). Its complement `T_μ` is therefore dense. -/
theorem countable_setOf_measure_not_continuousAt_ne_zero (μ : Measure (SkorokhodSpace E))
    [IsFiniteMeasure μ] : {t : I | μ {x | ¬ ContinuousAt (⇑x) t} ≠ 0}.Countable := by
  refine (Set.countable_iUnion fun m : ℕ ↦ Set.countable_iUnion fun j : ℕ ↦
    (finite_setOf_lt_measure_lt_jumpEDist μ (ε := (m : ℝ≥0∞)⁻¹) (η := (j : ℝ≥0∞)⁻¹)
      (ENNReal.inv_pos.2 (ENNReal.natCast_ne_top m))
      (ENNReal.inv_pos.2 (ENNReal.natCast_ne_top j))).countable).mono fun t ht ↦ ?_
  have hsub : {x : SkorokhodSpace E | ¬ ContinuousAt (⇑x) t} ⊆
      ⋃ m : ℕ, {x | (m : ℝ≥0∞)⁻¹ < jumpEDist t x} := by
    intro x hx
    have hpos : jumpEDist t x ≠ 0 := fun h ↦ hx (continuousAt_of_edist_leftLim_eq_zero x h)
    obtain ⟨m, hm⟩ := ENNReal.exists_inv_nat_lt hpos
    exact mem_iUnion.2 ⟨m, hm⟩
  have : μ (⋃ m : ℕ, {x | (m : ℝ≥0∞)⁻¹ < jumpEDist t x}) ≠ 0 :=
    fun h ↦ ht (measure_mono_null hsub h)
  obtain ⟨m, hm⟩ : ∃ m : ℕ, μ {x | (m : ℝ≥0∞)⁻¹ < jumpEDist t x} ≠ 0 := by
    by_contra! h
    exact this (measure_iUnion_null h)
  obtain ⟨j, hj⟩ := ENNReal.exists_inv_nat_lt hm
  exact mem_iUnion.2 ⟨m, mem_iUnion.2 ⟨j, hj⟩⟩

end FixedDiscontinuities

end SkorokhodSpace
